  @@index([type, isActive])
  @@map("products_services")
}

// ============================================================================
// M10. PARTIES, CUSTOMER CREDIT & SUPPLIER PAYMENT SECURITY
// ============================================================================

/// Shared identity record for customer and supplier profiles.
model Party {
  id                 String       @id @default(cuid())
  organizationId     String       @map("organization_id")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  kind               PartyKind
  displayName        String       @map("display_name")
  legalName          String?      @map("legal_name")
  firstName          String?      @map("first_name")
  lastName           String?      @map("last_name")
  taxIdentifier      String?      @map("tax_identifier")
  registrationNumber String?      @map("registration_number")
  email              String?
  phone              String?
  website            String?
  isActive           Boolean      @default(true) @map("is_active")
  createdById        String?      @map("created_by_id")
  updatedById        String?      @map("updated_by_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  customer       Customer?
  supplier       Supplier?
  contacts       Contact[]
  addresses      PartyAddress[]
  communications CommunicationLog[]

  @@unique([organizationId, code])
  @@index([organizationId, kind, displayName])
  @@index([organizationId, deletedAt])
  @@map("parties")
}

model Customer {
  id                  String           @id @default(cuid())
  organizationId      String           @map("organization_id")
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partyId             String           @unique @map("party_id")
  party               Party            @relation(fields: [partyId], references: [id], onDelete: Restrict)
  status              CustomerStatus   @default(PROSPECT)
  masterDataStatus    MasterDataStatus @default(PENDING_APPROVAL) @map("master_data_status")
  paymentTermsDays    Int              @default(30) @map("payment_terms_days")
  creditLimit         Decimal          @default(0) @map("credit_limit") @db.Decimal(20, 6)
  currencyCode        String           @default("TZS") @map("currency_code") @db.Char(3)
  relationshipOwnerId String?          @map("relationship_owner_id")
  riskLevel           PartyRiskLevel   @default(MEDIUM) @map("risk_level")
  creditHoldReason    String?          @map("credit_hold_reason")
  creditHeldAt        DateTime?        @map("credit_held_at")
  badDebtAmount       Decimal          @default(0) @map("bad_debt_amount") @db.Decimal(20, 6)
  createdById         String?          @map("created_by_id")
  updatedById         String?          @map("updated_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  creditHolds CustomerCreditHold[]
  receivables CustomerReceivable[]
  quotations  Quotation[]
  invoices    Invoice[]
  payments    Payment[]

  @@index([organizationId, status, masterDataStatus])
  @@index([organizationId, relationshipOwnerId])
  @@map("customers")
}

model Supplier {
  id                  String           @id @default(cuid())
  organizationId      String           @map("organization_id")
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partyId             String           @unique @map("party_id")
  party               Party            @relation(fields: [partyId], references: [id], onDelete: Restrict)
  status              SupplierStatus   @default(PROSPECT)
