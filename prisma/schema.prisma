  TOTP
  WEBAUTHN
}

enum MfaDeviceStatus {
  PENDING
  ACTIVE
  DISABLED
  REVOKED
}

enum SessionRevokeReason {
  LOGOUT
  TIMEOUT_IDLE
  TIMEOUT_ABSOLUTE
  PASSWORD_CHANGED
  MFA_CHANGED
  ADMIN_REVOKED
  SUSPECTED_COMPROMISE
}

