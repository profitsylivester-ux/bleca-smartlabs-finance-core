  actorId        String               @map("actor_id")
  actor          User                 @relation("ApprovalDecisionRecordActor", fields: [actorId], references: [id])
  decision       ApprovalDecision
  reason         String?
  sodViolation   Boolean              @default(false) @map("sod_violation")
  sodWaiverId    String?              @map("sod_waiver_id")
  delegationId   String?              @map("delegation_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([requestId])
  @@index([stepInstanceId])
  @@index([actorId])
  @@map("approval_decision_records")
}

model SODWaiver {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  user              User            @relation("SODWaiverUser", fields: [userId], references: [id], onDelete: Cascade)
  transactionId     String          @map("transaction_id")
  reason            String
  recordedById      String          @map("recorded_by_id")
  recordedBy        User            @relation("SODWaiverRecordedBy", fields: [recordedById], references: [id])
  recordedAt        DateTime        @default(now()) @map("recorded_at")
  approvalRequestId String          @map("approval_request_id")
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  status            SODWaiverStatus @default(PENDING)
  reviewedById      String?         @map("reviewed_by_id")
  reviewedBy        User?           @relation("SODWaiverReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?       @map("reviewed_at")
  reviewReason      String?         @map("review_reason")

  @@index([userId])
  @@index([transactionId])
  @@index([approvalRequestId])
  @@index([status])
  @@map("sod_waivers")
}

// ============================================================================
// B3. ORGANISATION ROOT
//
// Only the root row lands in M1. Locations, Departments, CostCentres, Projects,
// FundingSources and Currencies arrive in M2, which is why User.primary_location_id
// and User.home_department_id are plain scalars for now.
// ============================================================================

model Organization {
  id                   String             @id @default(cuid())
  code                 String             @unique
  name                 String
  legalName            String?            @map("legal_name")
  type                 OrganizationType   @default(SINGLE_ENTITY)
  /// PDF 2: BLECA is not yet registered.
  registrationStatus   RegistrationStatus @default(NOT_REGISTERED) @map("registration_status")
  registrationNumber   String?            @map("registration_number")
  /// Nullable until registered. NEVER hardcoded.
  tin                  String?            @map("tin")
  baseCurrency         String             @default("TZS") @map("base_currency") @db.Char(3)
  fiscalYearStartMonth Int                @default(1) @map("fiscal_year_start_month")
  fiscalYearEndDay     Int                @default(31) @map("fiscal_year_end_day")
  taxJurisdictions     Json?              @map("tax_jurisdictions")
  defaultLocationId    String?            @map("default_location_id")
  isActive             Boolean            @default(true) @map("is_active")
  settings             Json?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  memberships                      OrganizationMembership[]
  locations                        Location[]
  departments                      Department[]
  costCentres                      CostCentre[]
  projects                         Project[]
  fundingSources                   FundingSource[]
  masterDataChangeRequests         MasterDataChangeRequest[]
  reasonCodes                      ReasonCode[]
  reversalReasonCodes              ReversalReasonCode[]
  productsServices                 ProductService[]
  parties                          Party[]
  customers                        Customer[]
  suppliers                        Supplier[]
  communicationLogs                CommunicationLog[]
  supplierBankDetailChangeRequests SupplierBankDetailChangeRequest[]
  customerReceivables              CustomerReceivable[]
  quotations                       Quotation[]
  invoices                         Invoice[]
  payments                         Payment[]
  receipts                         Receipt[]
  creditNotes                      CreditNote[]
  debitNotes                       DebitNote[]
  documentSequences                DocumentSequence[]
  invoiceReminders                 InvoiceReminder[]
  documents                        Document[]
  documentTags                     DocumentTag[]
  retentionPolicies                RetentionPolicy[]
  documentVersions                 DocumentVersion[]
  documentTagLinks                 DocumentTagLink[]
  documentLinks                    DocumentLink[]
  legalHolds                       LegalHold[]
  accounts                         Account[]
  financialPeriods                 FinancialPeriod[]
  openingBalances                  OpeningBalance[]
  accountBalanceSnapshots          AccountBalanceSnapshot[]
  journalEntries                   JournalEntry[]
  journalLines                     JournalLine[]
  transactions                     Transaction[]
  budgets                          Budget[]
  budgetLines                      BudgetLine[]
  approvalPolicies                 ApprovalPolicy[]
  approvalRequests                 ApprovalRequest[]
  treasuryAccounts                 TreasuryAccount[]
  paymentSchedules                 PaymentSchedule[]
  transfers                        Transfer[]
  importBatches                    ImportBatch[]
  importFieldMappings              ImportFieldMapping[]
  matchingRules                    MatchingRule[]
  reconciliationSessions           ReconciliationSession[]
  reconciliationMatches            ReconciliationMatch[]
  reconciliationExceptions         ReconciliationException[]
  reconciliationAdjustments        ReconciliationAdjustment[]
  commitments                      Commitment[]
  budgetRevisions                  BudgetRevision[]
  budgetTransfers                  BudgetTransfer[]
  budgetScenarios                  BudgetScenario[]
  taxRules                         TaxRule[]
  taxObligations                   TaxObligation[]
  taxPayments                      TaxPayment[]
  credentials                      Credential[]
  complianceDocuments              ComplianceDocument[]
  taxInvoiceSequence               TaxInvoiceSequence?

  @@index([registrationStatus])
  @@map("organizations")
}

model Location {
  id                  String       @id @default(cuid())
  organizationId      String       @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  name                String
  type                LocationType
  isOwned             Boolean      @default(false) @map("is_owned")
  permissionReference String?      @map("permission_reference")
  parentId            String?      @map("parent_id")
  parent              Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children            Location[]   @relation("LocationHierarchy")
  address             Json?
  timezone            String       @default("Africa/Dar_es_Salaam")
  isActive            Boolean      @default(true) @map("is_active")
  effectiveFrom       DateTime?    @map("effective_from")
  effectiveTo         DateTime?    @map("effective_to")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  users            User[]            @relation("UserPrimaryLocation")
  journalLines     JournalLine[]
  transactions     Transaction[]
  treasuryAccounts TreasuryAccount[]

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@index([parentId])
  @@map("locations")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  parentId       String?      @map("parent_id")
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users        User[]        @relation("UserHomeDepartment")
  costCentres  CostCentre[]
  journalLines JournalLine[]
  transactions Transaction[]
  budgets      Budget[]
  commitments  Commitment[]

  @@unique([organizationId, code])
  @@index([parentId])
  @@map("departments")
}

model CostCentre {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?      @map("department_id")
  department     Department?  @relation(fields: [departmentId], references: [id])
  code           String
  name           String
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  journalLines JournalLine[]
  transactions Transaction[]
  budgets      Budget[]

  @@unique([organizationId, code])
  @@index([departmentId])
  @@map("cost_centres")
}

model Project {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  status         ProjectStatus @default(DRAFT)
  startDate      DateTime?     @map("start_date")
  endDate        DateTime?     @map("end_date")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  journalLines JournalLine[]
  transactions Transaction[]
  budgets      Budget[]
  commitments  Commitment[]

  @@unique([organizationId, code])
  @@index([status, isActive])
  @@map("projects")
}

model FundingSource {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           FundingSourceType
  description    String?
  isRestricted   Boolean           @default(false) @map("is_restricted")
  restrictions   Json?
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  journalLines     JournalLine[]
  transactions     Transaction[]
  treasuryAccounts TreasuryAccount[]
  budgets          Budget[]
  commitments      Commitment[]

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@map("funding_sources")
}

/// Treasury Accounts — PDF §10: cash, bank, mobile money, gateways, project/grant funds.
/// Each links to a ledger Account. Sensitive fields encrypted at rest.
model TreasuryAccount {
  id                String              @id @default(cuid())
  organizationId    String              @map("organization_id")
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  kind              TreasuryAccountKind
  currencyCode      String              @map("currency_code") @db.Char(3)
  currency          Currency            @relation(fields: [currencyCode], references: [code])
  ledgerAccountId   String              @map("ledger_account_id")
  ledgerAccount     Account             @relation(fields: [ledgerAccountId], references: [id])
  locationId        String?             @map("location_id")
  location          Location?           @relation(fields: [locationId], references: [id])
  fundingSourceId   String?             @map("funding_source_id")
  fundingSource     FundingSource?      @relation(fields: [fundingSourceId], references: [id])
  /// AES-256-GCM ciphertext. Plaintext account numbers/API keys must never reach the table.
  accountNumberEnc  String?             @map("account_number_enc")
  /// Provider-specific config (e.g., mobile money provider, gateway merchant ID).
  providerConfigEnc String?             @map("provider_config_enc")
  isActive          Boolean             @default(true) @map("is_active")
  isRestricted      Boolean             @default(false) @map("is_restricted")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  journalLines           JournalLine[]
  transactions           Transaction[]
  paymentSchedules       PaymentSchedule[]
  payments               Payment[]
  transfersAsSource      Transfer[]              @relation("TransferSource")
  transfersAsDestination Transfer[]              @relation("TransferDestination")
  reconciliationSessions ReconciliationSession[]

  @@unique([organizationId, code])
  @@index([kind, isActive])
  @@index([ledgerAccountId])
  @@index([fundingSourceId])
  @@map("treasury_accounts")
}

/// Payment Schedules — due/overdue status for recurring obligations.
model PaymentSchedule {
  id                String          @id @default(cuid())
  organizationId    String          @map("organization_id")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  treasuryAccountId String          @map("treasury_account_id")
  treasuryAccount   TreasuryAccount @relation(fields: [treasuryAccountId], references: [id])
  code              String
  description       String?
  amount            Decimal         @db.Decimal(20, 6)
  currencyCode      String          @map("currency_code") @db.Char(3)
  currency          Currency        @relation(fields: [currencyCode], references: [code])
  frequency         String // DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUALLY, CUSTOM
  nextDueDate       DateTime        @map("next_due_date") @db.Date
  endDate           DateTime?       @map("end_date") @db.Date
  status            String          @default("SCHEDULED") // SCHEDULED, DUE, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([treasuryAccountId, status])
  @@index([nextDueDate])
  @@map("payment_schedules")
}

/// Transfers — PDF §10: single balanced JournalEntry with credit on source, debit on destination.
/// Cross-currency produces FX difference entry. Never distorts P&L.
model Transfer {
  id                      String              @id @default(cuid())
  organizationId          String              @map("organization_id")
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                    String
  status                  TransferStatus      @default(DRAFT)
  sourceAccountId         String              @map("source_account_id")
  sourceAccount           TreasuryAccount     @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccountId    String              @map("destination_account_id")
  destinationAccount      TreasuryAccount     @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  amount                  Decimal             @db.Decimal(20, 6)
  currencyCode            String              @map("currency_code") @db.Char(3)
  currency                Currency            @relation(fields: [currencyCode], references: [code])
  destinationAmount       Decimal?            @map("destination_amount") @db.Decimal(20, 6)
  destinationCurrencyCode String?             @map("destination_currency_code") @db.Char(3)
  destinationCurrency     Currency?           @relation("TransferDestinationCurrency", fields: [destinationCurrencyCode], references: [code])
  fxRate                  Decimal?            @map("fx_rate") @db.Decimal(20, 10)
  description             String?
  reference               String?
  submittedById           String?             @map("submitted_by_id")
  submittedBy             User?               @relation("TransferSubmittedBy", fields: [submittedById], references: [id])
  submittedAt             DateTime?           @map("submitted_at")
  approvedById            String?             @map("approved_by_id")
  approvedBy              User?               @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  approvedAt              DateTime?           @map("approved_at")
  processedById           String?             @map("processed_by_id")
  processedBy             User?               @relation("TransferProcessedBy", fields: [processedById], references: [id])
  processedAt             DateTime?           @map("processed_at")
  reversedById            String?             @map("reversed_by_id")
  reversedBy              User?               @relation("TransferReversedBy", fields: [reversedById], references: [id])
  reversedAt              DateTime?           @map("reversed_at")
  reversalReasonId        String?             @map("reversal_reason_id")
  reversalReason          ReversalReasonCode? @relation("TransferReversalReason", fields: [reversalReasonId], references: [id])
  journalEntryId          String?             @map("journal_entry_id")
  journalEntry            JournalEntry?       @relation("TransferJournalEntry", fields: [journalEntryId], references: [id])
  reversalJournalEntryId  String?             @map("reversal_journal_entry_id")
  reversalJournalEntry    JournalEntry?       @relation("TransferReversalJournalEntry", fields: [reversalJournalEntryId], references: [id])
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([status])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transfers")
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PROCESSED
  FAILED
  REVERSED
  CANCELLED
}

model Currency {
  id            String       @id @default(cuid())
  code          String       @unique @db.Char(3)
  name          String
  symbol        String?
  type          CurrencyType @default(FIAT)
  decimalPlaces Int          @default(2)
  isBase        Boolean      @default(false) @map("is_base")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  exchangeRatesBase              ExchangeRate[]           @relation("ExchangeRateBase")
  exchangeRatesQuote             ExchangeRate[]           @relation("ExchangeRateQuote")
  productsServices               ProductService[]
  openingBalances                OpeningBalance[]
  accountBalanceSnapshots        AccountBalanceSnapshot[]
  journalLines                   JournalLine[]
  transactions                   Transaction[]
  treasuryAccounts               TreasuryAccount[]
  paymentSchedules               PaymentSchedule[]
  transfers                      Transfer[]
  transfersAsDestinationCurrency Transfer[]               @relation("TransferDestinationCurrency")
  budgets                        Budget[]
  commitments                    Commitment[]

  @@map("currencies")
}

model ExchangeRate {
  id                  String                @id @default(cuid())
  baseCurrencyId      String                @map("base_currency_id")
  baseCurrency        Currency              @relation("ExchangeRateBase", fields: [baseCurrencyId], references: [id])
  quoteCurrencyId     String                @map("quote_currency_id")
  quoteCurrency       Currency              @relation("ExchangeRateQuote", fields: [quoteCurrencyId], references: [id])
  rateDate            DateTime              @map("rate_date")
  rate                Decimal               @db.Decimal(20, 10)
  source              String?               @default("MANUAL")
  differenceTreatment FxDifferenceTreatment @default(EXPENSE) @map("difference_treatment")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@unique([baseCurrencyId, quoteCurrencyId, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

model MasterDataChangeRequest {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType      AuditEntityType        @map("entity_type")
  entityId        String?                @map("entity_id")
  proposedChanges Json                   @map("proposed_changes")
  reason          String
  status          MasterDataChangeStatus @default(DRAFT) @map("status")
  requestedById   String                 @map("requested_by_id")
  requestedBy     User                   @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?                @map("approved_by_id")
  approvedBy      User?                  @relation("ChangeRequestApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?              @map("approved_at")
  effectiveDate   DateTime?              @map("effective_date")
  expiresAt       DateTime?              @map("expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  versions MasterDataVersion[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([requestedById])
  @@index([status, effectiveDate])
  @@map("master_data_change_requests")
}

model MasterDataVersion {
  id              String                  @id @default(cuid())
  changeRequestId String                  @map("change_request_id")
  changeRequest   MasterDataChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  entityType      AuditEntityType         @map("entity_type")
  entityId        String?                 @map("entity_id")
  versionNumber   Int                     @map("version_number")
  snapshot        Json                    @map("snapshot")
  changedFields   Json?                   @map("changed_fields")
  effectiveFrom   DateTime                @map("effective_from")
  effectiveTo     DateTime?               @map("effective_to")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@unique([changeRequestId, versionNumber])
  @@index([entityType, entityId])
  @@index([effectiveFrom])
  @@map("master_data_versions")
}

/// Reason codes for transaction categorization (PDF 62). Seeded as reference data.
model ReasonCode {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  category       String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  reconciliationAdjustments ReconciliationAdjustment[]

  @@unique([organizationId, code])
  @@index([category, isActive])
  @@map("reason_codes")
}

/// Lightweight product/service catalogue for revenue linkage (PDF 62).
model ProductService {
  id             String                   @id @default(cuid())
  organizationId String                   @map("organization_id")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  type           String // "PRODUCT" | "SERVICE"
  unit           String? // e.g., "HOUR", "DAY", "UNIT", "MONTH"
  unitPrice      Decimal?                 @map("unit_price") @db.Decimal(20, 6)
  currencyCode   String?                  @map("currency_code") @db.Char(3)
  currency       Currency?                @relation(fields: [currencyCode], references: [code])
  isActive       Boolean                  @default(true) @map("is_active")
  supplierLinks  SupplierProductService[]
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

