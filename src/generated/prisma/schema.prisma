model User {
  id              String  @id @default(cuid())
  email           String
  emailNormalized String  @unique @map("email_normalized")
  fullName        String  @map("full_name")
  jobTitle        String? @map("job_title")
  phone           String?
  avatarUrl       String? @map("avatar_url")

  status             UserStatus @default(INVITED)
  isActive           Boolean    @default(true)
  deactivatedAt      DateTime?  @map("deactivated_at")
  deactivationReason String?    @map("deactivation_reason")

  // --- Credentials -----------------------------------------------------------
  passwordHash           String?                @map("password_hash")
  passwordAlgorithm      PasswordHashAlgorithm? @map("password_algorithm")
  passwordChangedAt      DateTime?              @map("password_changed_at")
  mustChangePassword     Boolean                @default(false) @map("must_change_password")
  failedLoginCount       Int                    @default(0) @map("failed_login_count")
  lockedUntil            DateTime?              @map("locked_until")
  lastLoginAt            DateTime?              @map("last_login_at")
  emailVerifiedAt        DateTime?              @map("email_verified_at")
  passwordResetToken     String?                @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime?              @map("password_reset_expires_at")

  /// Prior password hashes, retained so "do not reuse" can be enforced later
  /// without losing history.
  passwordHistory String[] @default([]) @map("password_history")

  // --- MFA (PDF 4) -----------------------------------------------------------
  /// Enforced for CEO and Finance Officer by default (BUILD_PROMPT 7). Seeded
  /// from the ROLE, never from a client-supplied flag.
  mfaEnforced   Boolean   @default(false) @map("mfa_enforced")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  // --- Organisation context --------------------------------------------------
  primaryLocationId String?     @map("primary_location_id")
  primaryLocation   Location?   @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id])
  homeDepartmentId  String?     @map("home_department_id")
  homeDepartment    Department? @relation("UserHomeDepartment", fields: [homeDepartmentId], references: [id])

  /// PDF 56: classification for data-protection handling. Not a legal claim.
  dataClassification String    @default("INTERNAL") @map("data_classification")
  retentionReviewAt  DateTime? @map("retention_review_at")

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organizationMemberships          OrganizationMembership[]
  sessions                         Session[]
  loginHistory                     LoginHistory[]
  mfaDevices                       MfaDevice[]
  userRoles                        UserRole[]
  delegationsGranted               Delegation[]              @relation("DelegationGrantor")
  delegationsReceived              Delegation[]              @relation("DelegationGrantee")
  accessReviewItems                AccessReviewItem[]
  notifications                    Notification[]
  notificationPreferences          NotificationPreference[]
  createdUsers                     User[]                    @relation("UserCreatedBy")
  updatedUsers                     User[]                    @relation("UserUpdatedBy")
  changeRequestsRequested          MasterDataChangeRequest[] @relation("ChangeRequestRequestedBy")
  changeRequestsApproved           MasterDataChangeRequest[] @relation("ChangeRequestApprovedBy")
  journalEntriesSubmitted          JournalEntry[]            @relation("JournalEntrySubmittedBy")
  journalEntriesApproved           JournalEntry[]            @relation("JournalEntryApprovedBy")
  journalEntriesPosted             JournalEntry[]            @relation("JournalEntryPostedBy")
  journalEntriesReversed           JournalEntry[]            @relation("JournalEntryReversedBy")
  transactionsCreated              Transaction[]             @relation("TransactionCreatedBy")
  transactionsSubmitted            Transaction[]             @relation("TransactionSubmittedBy")
  transactionsApproved             Transaction[]             @relation("TransactionApprovedBy")
  transactionsPosted               Transaction[]             @relation("TransactionPostedBy")
  transactionsReversed             Transaction[]             @relation("TransactionReversedBy")
  approvalRequestsSubmitted        ApprovalRequest[]         @relation("ApprovalRequestSubmittedBy")
  approvalRequestsDecided          ApprovalRequest[]         @relation("ApprovalRequestDecidedBy")
  approvalStepInstancesDecided     ApprovalStepInstance[]    @relation("ApprovalStepInstanceDecidedBy")
  approvalDecisionRecords          ApprovalDecisionRecord[]  @relation("ApprovalDecisionRecordActor")
  approvalPolicyStepAssigneeUser   ApprovalPolicyStep[]      @relation("ApprovalPolicyStepAssigneeUser")
  approvalStepInstanceAssigneeUser ApprovalStepInstance[]    @relation("ApprovalStepInstanceAssigneeUser")
  sodWaiversAsUser                 SODWaiver[]               @relation("SODWaiverUser")
  sodWaiversRecordedBy             SODWaiver[]               @relation("SODWaiverRecordedBy")
  sodWaiversReviewedBy             SODWaiver[]               @relation("SODWaiverReviewedBy")
  transfersSubmitted               Transfer[]                @relation("TransferSubmittedBy")
  transfersApproved                Transfer[]                @relation("TransferApprovedBy")
  transfersProcessed               Transfer[]                @relation("TransferProcessedBy")
  transfersReversed                Transfer[]                @relation("TransferReversedBy")
  importBatchesUploaded            ImportBatch[]             @relation("ImportBatchUploadedBy")
  importBatchesMapped              ImportBatch[]             @relation("ImportBatchMappedBy")
  importBatchesValidated           ImportBatch[]             @relation("ImportBatchValidatedBy")
  importBatchesApproved            ImportBatch[]             @relation("ImportBatchApprovedBy")
  importBatchesImported            ImportBatch[]             @relation("ImportBatchImportedBy")
  importBatchesRolledBack          ImportBatch[]             @relation("ImportBatchRolledBackBy")
  importFieldMappingsCreated       ImportFieldMapping[]      @relation("ImportFieldMappingCreatedBy")
  importErrorsResolved             ImportError[]             @relation("ImportErrorResolvedBy")

  @@index([status, isActive])
  @@index([primaryLocationId])
  @@index([homeDepartmentId])
  @@index([deletedAt])
  @@map("users")
}

model MfaDevice {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  method           MfaMethod       @default(TOTP)
  label            String
  /// AES-256-GCM ciphertext. A plaintext TOTP secret must never reach the table.
  secretEnc        String          @map("secret_enc")
  recoveryCodesEnc String?         @map("recovery_codes_enc")
  status           MfaDeviceStatus @default(PENDING)
  confirmedAt      DateTime?       @map("confirmed_at")
  lastUsedAt       DateTime?       @map("last_used_at")
  /// Replay protection: the last accepted counter. A TOTP code may not be reused.
  lastUsedCounter  Int             @default(-1) @map("last_used_counter")
  failedAttempts   Int             @default(0) @map("failed_attempts")
  lockedUntil      DateTime?       @map("locked_until")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("mfa_devices")
}

model Session {
  id                String               @id @default(cuid())
  /// Referenced by the `sid` claim in the Auth.js JWT. Rotated on privilege change.
  sessionToken      String               @unique @map("session_token")
  userId            String               @map("user_id")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress         String?              @map("ip_address")
  userAgent         String?              @map("user_agent")
  deviceFingerprint String?              @map("device_fingerprint")
  deviceLabel       String?              @map("device_label")
  createdAt         DateTime             @default(now()) @map("created_at")
  lastActiveAt      DateTime             @default(now()) @map("last_active_at")
  /// Both timeouts are resolved from AuthPolicy at issue time and then enforced
  /// against these absolute instants, so a later policy change cannot silently
  /// extend a session that is already live.
  idleTimeoutAt     DateTime?            @map("idle_timeout_at")
  absoluteExpiresAt DateTime             @map("absolute_expires_at")
  revokedAt         DateTime?            @map("revoked_at")
  revokedReason     SessionRevokeReason? @map("revoked_reason")
  mfaSatisfiedAt    DateTime?            @map("mfa_satisfied_at")
  /// Step-up authentication: set when the actor re-authenticated for a sensitive
  /// action. Cleared once consumed.
  stepUpSatisfiedAt DateTime?            @map("step_up_satisfied_at")
  stepUpExpiresAt   DateTime?            @map("step_up_expires_at")

  @@index([userId, lastActiveAt])
  @@index([deviceFingerprint])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model LoginHistory {
  id                String       @id @default(cuid())
  userId            String?      @map("user_id")
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailAttempted    String       @map("email_attempted")
  outcome           LoginOutcome
  ipAddress         String?      @map("ip_address")
  userAgent         String?      @map("user_agent")
  deviceFingerprint String?      @map("device_fingerprint")
  mfaAttempted      Boolean      @default(false) @map("mfa_attempted")
  failureReason     String?      @map("failure_reason")
  sessionId         String?      @map("session_id")
  occurredAt        DateTime     @default(now()) @map("occurred_at")

  @@index([userId, occurredAt])
  @@index([emailAttempted, occurredAt])
  @@index([outcome, occurredAt])
  @@map("login_history")
}

/// Lockout, rate limiting, password strength and session timeouts are CONFIG,
/// not code (PDF 4). Changing one is an audited CONFIGURATION_CHANGES event.
model AuthPolicy {
  id       String @id @default(cuid())
  name     String @unique
  priority Int    @default(100)

  maxFailedAttempts      Int @default(5) @map("max_failed_attempts")
  lockoutDurationMinutes Int @default(15) @map("lockout_duration_minutes")
  rateLimitWindowSeconds Int @default(60) @map("rate_limit_window_seconds")
  maxAttemptsPerWindow   Int @default(10) @map("max_attempts_per_window")
  ipRateLimitPerMinute   Int @default(20) @map("ip_rate_limit_per_minute")

  sessionIdleTimeoutMinutes   Int @default(30) @map("session_idle_timeout_minutes")
  sessionAbsoluteTimeoutHours Int @default(12) @map("session_absolute_timeout_hours")

  passwordMinLength        Int     @default(12) @map("password_min_length")
  passwordRequireUppercase Boolean @default(true) @map("password_require_uppercase")
  passwordRequireLowercase Boolean @default(true) @map("password_require_lowercase")
  passwordRequireNumber    Boolean @default(true) @map("password_require_number")
  passwordRequireSymbol    Boolean @default(true) @map("password_require_symbol")

  /// Role codes that must hold MFA. Seeded with CEO and FINANCE_OFFICER.
  mfaRequiredRoleCodes       String[] @default([]) @map("mfa_required_role_codes")
  /// Lifetime of the pre-MFA challenge session.
  mfaChallengeTimeoutMinutes Int      @default(10) @map("mfa_challenge_timeout_minutes")
  /// Lifetime of a step-up authentication grant.
  stepUpTimeoutMinutes       Int      @default(5) @map("step_up_timeout_minutes")

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@index([isActive, priority])
  @@map("auth_policies")
}

// ============================================================================
// B2. RBAC   (PDF 5)
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  type        RoleType @default(STANDARD)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)

  /// CEO final authority (PDF 3.1).
  isFinalApprover   Boolean @default(false) @map("is_final_approver")
  /// ALWAYS false in Phase 1. No role can bypass approval; the CEO path is a
  /// recorded per-item waiver, not a standing bypass (Q3).
  canBypassApproval Boolean @default(false) @map("can_bypass_approval")

  /// Q2: every amount requires CEO approval in Phase 1. These columns exist for
  /// the future configuration path and are NOT seeded with a band.
  maxApprovalAmount Decimal? @map("max_approval_amount") @db.Decimal(20, 6)
  approvalCurrency  String?  @map("approval_currency") @db.Char(3)

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions                  RolePermission[]
  scopeGrants                      RoleScopeGrant[]
  userRoles                        UserRole[]
  delegations                      Delegation[]
  accessReviewItems                AccessReviewItem[]
  approvalPolicySteps              ApprovalPolicyStep[]   @relation("ApprovalPolicyStepAssigneeRole")
  approvalStepInstanceAssigneeRole ApprovalStepInstance[] @relation("ApprovalStepInstanceAssigneeRole")

  @@index([isSystem, isActive])
  @@map("roles")
}

model Permission {
  id                 String           @id @default(cuid())
  module             ModuleKey
  action             PermissionAction
  /// Optional sub-resource, e.g. "supplier.bank_details".
  resource           String?
  description        String?
  /// PDF 5: sensitive actions take additional authorization. Set on supplier bank
  /// details, permission changes, period reopen and high-value exports.
  requiresStepUpAuth Boolean          @default(false) @map("requires_step_up_auth")

  roles       RolePermission[]
  scopeGrants RoleScopeGrant[]

  @@unique([module, action, resource])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  /// Extra constraints attached to this specific grant.
  conditions   Json?

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// PDF 4: temporary access. `expiresAt` is mandatory whenever isTemporary.
  isTemporary Boolean   @default(false) @map("is_temporary")
  startsAt    DateTime  @default(now()) @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  grantedById String?   @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  reason      String?

  @@index([userId, revokedAt])
  @@index([roleId])
  @@index([expiresAt])
  @@map("user_roles")
}

/// Dimension-scoped grants (PDF 5). dimension_value_id = NULL means "all values".
/// DENY always wins over ALLOW (resolution order in lib/rbac/scope.ts).
model RoleScopeGrant {
  id               String         @id @default(cuid())
  roleId           String         @map("role_id")
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId     String?        @map("permission_id")
  permission       Permission?    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  dimension        ScopeDimension
  dimensionValueId String?        @map("dimension_value_id")
  includeChildren  Boolean        @default(false) @map("include_children")
  effect           String         @default("ALLOW")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roleId, dimension])
  @@index([dimension, dimensionValueId])
  @@map("role_scope_grants")
}

/// PDF 4: delegated authority. `expiresAt` is MANDATORY and validated in code -
/// an open-ended delegation is rejected, not merely discouraged.
model Delegation {
  id        String @id @default(cuid())
  grantorId String @map("grantor_id")
  grantor   User   @relation("DelegationGrantor", fields: [grantorId], references: [id], onDelete: Cascade)
  granteeId String @map("grantee_id")
  grantee   User   @relation("DelegationGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  kind             DelegationKind
  roleId           String?        @map("role_id")
  role             Role?          @relation(fields: [roleId], references: [id])
  /// Dimension limits, amount ceilings, entity limits.
  scope            Json?
  reason           String
  startsAt         DateTime       @map("starts_at")
  /// Mandatory. Enforced in the service layer and by the "no unbounded
  /// delegation" test.
  expiresAt        DateTime       @map("expires_at")
  revokedAt        DateTime?      @map("revoked_at")
  revokedById      String?        @map("revoked_by_id")
  revocationReason String?        @map("revocation_reason")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([granteeId, expiresAt])
  @@index([grantorId])
  @@index([roleId])
  @@map("delegations")
}

model AccessReview {
  id            String             @id @default(cuid())
  name          String
  periodStart   DateTime           @map("period_start")
  periodEnd     DateTime           @map("period_end")
  status        AccessReviewStatus @default(OPEN)
  scopeJson     Json?              @map("scope_json")
  initiatedById String             @map("initiated_by_id")
  completedAt   DateTime?          @map("completed_at")
  summary       String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items AccessReviewItem[]

  @@index([status])
  @@map("access_reviews")
}

model AccessReviewItem {
  id               String       @id @default(cuid())
  reviewId         String       @map("review_id")
  review           AccessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId           String       @map("user_id")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Held by plain id, deliberately: a review must show what was granted at the
  /// time it was opened, so it reads the role as it is now but never joins to a
  /// live user_role row.
  roleId           String       @map("role_id")
  role             Role         @relation(fields: [roleId], references: [id])
  currentExpiresAt DateTime?    @map("current_expires_at")
  decision         String?
  decisionReason   String?      @map("decision_reason")
  decidedById      String?      @map("decided_by_id")
  decidedAt        DateTime?    @map("decided_at")
  actionedAt       DateTime?    @map("actioned_at")

  @@unique([reviewId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("access_review_items")
}

/// Approval Workflow models (M6) -------------------------------------------------
model ApprovalPolicy {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  entityType     ApprovalEntityType
  isActive       Boolean            @default(true)
  priority       Int                @default(100)
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedById    String?            @map("updated_by_id")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  steps    ApprovalPolicyStep[] @relation("ApprovalPolicySteps")
  requests ApprovalRequest[]    @relation("ApprovalRequestPolicy")

  @@index([organizationId, entityType, isActive])
  @@map("approval_policies")
}

model ApprovalPolicyStep {
  id                String                     @id @default(cuid())
  policyId          String                     @map("policy_id")
  policy            ApprovalPolicy             @relation("ApprovalPolicySteps", fields: [policyId], references: [id], onDelete: Cascade)
  stepOrder         Int                        @map("step_order")
  name              String
  type              ApprovalStepType
  assigneeType      ApprovalAssigneeType       @map("assignee_type")
  assigneeRoleId    String?                    @map("assignee_role_id")
  assigneeRole      Role?                      @relation("ApprovalPolicyStepAssigneeRole", fields: [assigneeRoleId], references: [id])
  assigneeUserId    String?                    @map("assignee_user_id")
  assigneeUser      User?                      @relation("ApprovalPolicyStepAssigneeUser", fields: [assigneeUserId], references: [id])
  resolutionMode    ResolutionMode             @default(ANY) @map("resolution_mode")
  quorum            Int? // used when resolutionMode = QUORUM
  conditionOperator ApprovalConditionOperator? @map("condition_operator")
  conditionValue    Json?                      @map("condition_value")
  isRequired        Boolean                    @default(true) @map("is_required")
  isFinalApprover   Boolean                    @default(false) @map("is_final_approver")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@unique([policyId, stepOrder])
  @@index([policyId])
  @@map("approval_policy_steps")
}

model ApprovalRequest {
  id               String                @id @default(cuid())
  organizationId   String                @map("organization_id")
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType       ApprovalEntityType    @map("entity_type")
  entityId         String                @map("entity_id")
  policyId         String                @map("policy_id")
  policy           ApprovalPolicy        @relation("ApprovalRequestPolicy", fields: [policyId], references: [id])
  policySnapshot   Json                  @map("policy_snapshot")
  status           ApprovalRequestStatus @default(PENDING)
  submittedById    String                @map("submitted_by_id")
  submittedBy      User                  @relation("ApprovalRequestSubmittedBy", fields: [submittedById], references: [id])
  submittedAt      DateTime              @default(now()) @map("submitted_at")
  currentStepIndex Int                   @default(0) @map("current_step_index")
  decidedAt        DateTime?             @map("decided_at")
  decidedById      String?               @map("decided_by_id")
  decidedBy        User?                 @relation("ApprovalRequestDecidedBy", fields: [decidedById], references: [id])
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  stepInstances   ApprovalStepInstance[]   @relation("ApprovalRequestStepInstances")
  decisionRecords ApprovalDecisionRecord[] @relation("ApprovalRequestDecisionRecords")
  sodWaivers      SODWaiver[]

  @@index([organizationId, entityType, entityId])
  @@index([status])
  @@index([submittedById])
  @@map("approval_requests")
}

model ApprovalStepInstance {
  id             String                @id @default(cuid())
  requestId      String                @map("request_id")
  request        ApprovalRequest       @relation("ApprovalRequestStepInstances", fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder      Int                   @map("step_order")
  stepName       String                @map("step_name")
  stepType       ApprovalStepType      @map("step_type")
  assigneeType   ApprovalAssigneeType  @map("assignee_type")
  assigneeRoleId String?               @map("assignee_role_id")
  assigneeRole   Role?                 @relation("ApprovalStepInstanceAssigneeRole", fields: [assigneeRoleId], references: [id])
  assigneeUserId String?               @map("assignee_user_id")
  assigneeUser   User?                 @relation("ApprovalStepInstanceAssigneeUser", fields: [assigneeUserId], references: [id])
  resolutionMode ResolutionMode        @map("resolution_mode")
  quorum         Int?
  status         ApprovalRequestStatus @default(PENDING)
  decidedAt      DateTime?             @map("decided_at")
  decidedById    String?               @map("decided_by_id")
  decidedBy      User?                 @relation("ApprovalStepInstanceDecidedBy", fields: [decidedById], references: [id])
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  decisions ApprovalDecisionRecord[] @relation("ApprovalStepInstanceDecisions")

  @@unique([requestId, stepOrder])
  @@index([requestId])
  @@index([assigneeUserId, status])
  @@index([assigneeRoleId, status])
  @@map("approval_step_instances")
}

model ApprovalDecisionRecord {
  id             String               @id @default(cuid())
  requestId      String               @map("request_id")
  request        ApprovalRequest      @relation("ApprovalRequestDecisionRecords", fields: [requestId], references: [id], onDelete: Cascade)
  stepInstanceId String               @map("step_instance_id")
  stepInstance   ApprovalStepInstance @relation("ApprovalStepInstanceDecisions", fields: [stepInstanceId], references: [id], onDelete: Cascade)
  actorId        String               @map("actor_id")
  actor          User                 @relation("ApprovalDecisionRecordActor", fields: [actorId], references: [id])
  decision       ApprovalDecision
  reason         String?
  sodViolation   Boolean              @default(false) @map("sod_violation")
  sodWaiverId    String?              @map("sod_waiver_id")
  delegationId   String?              @map("delegation_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([requestId])
  @@index([stepInstanceId])
  @@index([actorId])
  @@map("approval_decision_records")
}

model SODWaiver {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  user              User            @relation("SODWaiverUser", fields: [userId], references: [id], onDelete: Cascade)
  transactionId     String          @map("transaction_id")
  reason            String
  recordedById      String          @map("recorded_by_id")
  recordedBy        User            @relation("SODWaiverRecordedBy", fields: [recordedById], references: [id])
  recordedAt        DateTime        @default(now()) @map("recorded_at")
  approvalRequestId String          @map("approval_request_id")
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  status            SODWaiverStatus @default(PENDING)
  reviewedById      String?         @map("reviewed_by_id")
  reviewedBy        User?           @relation("SODWaiverReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?       @map("reviewed_at")
  reviewReason      String?         @map("review_reason")

  @@index([userId])
  @@index([transactionId])
  @@index([approvalRequestId])
  @@index([status])
  @@map("sod_waivers")
}

// ============================================================================
// B3. ORGANISATION ROOT
//
// Only the root row lands in M1. Locations, Departments, CostCentres, Projects,
// FundingSources and Currencies arrive in M2, which is why User.primary_location_id
// and User.home_department_id are plain scalars for now.
// ============================================================================

model Organization {
  id                   String             @id @default(cuid())
  code                 String             @unique
  name                 String
  legalName            String?            @map("legal_name")
  type                 OrganizationType   @default(SINGLE_ENTITY)
  /// PDF 2: BLECA is not yet registered.
  registrationStatus   RegistrationStatus @default(NOT_REGISTERED) @map("registration_status")
  registrationNumber   String?            @map("registration_number")
  /// Nullable until registered. NEVER hardcoded.
  tin                  String?            @map("tin")
  baseCurrency         String             @default("TZS") @map("base_currency") @db.Char(3)
  fiscalYearStartMonth Int                @default(1) @map("fiscal_year_start_month")
  fiscalYearEndDay     Int                @default(31) @map("fiscal_year_end_day")
  taxJurisdictions     Json?              @map("tax_jurisdictions")
  defaultLocationId    String?            @map("default_location_id")
  isActive             Boolean            @default(true) @map("is_active")
  settings             Json?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  memberships              OrganizationMembership[]
  locations                Location[]
  departments              Department[]
  costCentres              CostCentre[]
  projects                 Project[]
  fundingSources           FundingSource[]
  masterDataChangeRequests MasterDataChangeRequest[]
  reasonCodes              ReasonCode[]
  reversalReasonCodes      ReversalReasonCode[]
  productsServices         ProductService[]
  accounts                 Account[]
  financialPeriods         FinancialPeriod[]
  openingBalances          OpeningBalance[]
  accountBalanceSnapshots  AccountBalanceSnapshot[]
  journalEntries           JournalEntry[]
  journalLines             JournalLine[]
  transactions             Transaction[]
  budgets                  Budget[]
  budgetLines              BudgetLine[]
  approvalPolicies         ApprovalPolicy[]
  approvalRequests         ApprovalRequest[]
  treasuryAccounts         TreasuryAccount[]
  paymentSchedules         PaymentSchedule[]
  transfers                Transfer[]
  importBatches            ImportBatch[]
  importFieldMappings      ImportFieldMapping[]

  @@index([registrationStatus])
  @@map("organizations")
}

model Location {
  id                  String       @id @default(cuid())
  organizationId      String       @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String
  name                String
  type                LocationType
  isOwned             Boolean      @default(false) @map("is_owned")
  permissionReference String?      @map("permission_reference")
  parentId            String?      @map("parent_id")
  parent              Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children            Location[]   @relation("LocationHierarchy")
  address             Json?
  timezone            String       @default("Africa/Dar_es_Salaam")
  isActive            Boolean      @default(true) @map("is_active")
  effectiveFrom       DateTime?    @map("effective_from")
  effectiveTo         DateTime?    @map("effective_to")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  users            User[]            @relation("UserPrimaryLocation")
  journalLines     JournalLine[]
  transactions     Transaction[]
  treasuryAccounts TreasuryAccount[]

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@index([parentId])
  @@map("locations")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  parentId       String?      @map("parent_id")
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users        User[]        @relation("UserHomeDepartment")
  costCentres  CostCentre[]
  journalLines JournalLine[]
  transactions Transaction[]

  @@unique([organizationId, code])
  @@index([parentId])
  @@map("departments")
}

model CostCentre {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?      @map("department_id")
  department     Department?  @relation(fields: [departmentId], references: [id])
  code           String
  name           String
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  journalLines JournalLine[]
  transactions Transaction[]

  @@unique([organizationId, code])
  @@index([departmentId])
  @@map("cost_centres")
}

model Project {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  status         ProjectStatus @default(DRAFT)
  startDate      DateTime?     @map("start_date")
  endDate        DateTime?     @map("end_date")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  journalLines JournalLine[]
  transactions Transaction[]

  @@unique([organizationId, code])
  @@index([status, isActive])
  @@map("projects")
}

model FundingSource {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           FundingSourceType
  description    String?
  isRestricted   Boolean           @default(false) @map("is_restricted")
  restrictions   Json?
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  journalLines     JournalLine[]
  transactions     Transaction[]
  treasuryAccounts TreasuryAccount[]

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@map("funding_sources")
}

/// Treasury Accounts — PDF §10: cash, bank, mobile money, gateways, project/grant funds.
/// Each links to a ledger Account. Sensitive fields encrypted at rest.
model TreasuryAccount {
  id                String              @id @default(cuid())
  organizationId    String              @map("organization_id")
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  kind              TreasuryAccountKind
  currencyCode      String              @map("currency_code") @db.Char(3)
  currency          Currency            @relation(fields: [currencyCode], references: [code])
  ledgerAccountId   String              @map("ledger_account_id")
  ledgerAccount     Account             @relation(fields: [ledgerAccountId], references: [id])
  locationId        String?             @map("location_id")
  location          Location?           @relation(fields: [locationId], references: [id])
  fundingSourceId   String?             @map("funding_source_id")
  fundingSource     FundingSource?      @relation(fields: [fundingSourceId], references: [id])
  /// AES-256-GCM ciphertext. Plaintext account numbers/API keys must never reach the table.
  accountNumberEnc  String?             @map("account_number_enc")
  /// Provider-specific config (e.g., mobile money provider, gateway merchant ID).
  providerConfigEnc String?             @map("provider_config_enc")
  isActive          Boolean             @default(true) @map("is_active")
  isRestricted      Boolean             @default(false) @map("is_restricted")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  journalLines           JournalLine[]
  transactions           Transaction[]
  paymentSchedules       PaymentSchedule[]
  transfersAsSource      Transfer[]        @relation("TransferSource")
  transfersAsDestination Transfer[]        @relation("TransferDestination")

  @@unique([organizationId, code])
  @@index([kind, isActive])
  @@index([ledgerAccountId])
  @@index([fundingSourceId])
  @@map("treasury_accounts")
}

/// Payment Schedules — due/overdue status for recurring obligations.
model PaymentSchedule {
  id                String          @id @default(cuid())
  organizationId    String          @map("organization_id")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  treasuryAccountId String          @map("treasury_account_id")
  treasuryAccount   TreasuryAccount @relation(fields: [treasuryAccountId], references: [id])
  code              String
  description       String?
  amount            Decimal         @db.Decimal(20, 6)
  currencyCode      String          @map("currency_code") @db.Char(3)
  currency          Currency        @relation(fields: [currencyCode], references: [code])
  frequency         String // DAILY, WEEKLY, MONTHLY, QUARTERLY, ANNUALLY, CUSTOM
  nextDueDate       DateTime        @map("next_due_date") @db.Date
  endDate           DateTime?       @map("end_date") @db.Date
  status            String          @default("SCHEDULED") // SCHEDULED, DUE, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([treasuryAccountId, status])
  @@index([nextDueDate])
  @@map("payment_schedules")
}

/// Transfers — PDF §10: single balanced JournalEntry with credit on source, debit on destination.
/// Cross-currency produces FX difference entry. Never distorts P&L.
model Transfer {
  id                      String              @id @default(cuid())
  organizationId          String              @map("organization_id")
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                    String
  status                  TransferStatus      @default(DRAFT)
  sourceAccountId         String              @map("source_account_id")
  sourceAccount           TreasuryAccount     @relation("TransferSource", fields: [sourceAccountId], references: [id])
  destinationAccountId    String              @map("destination_account_id")
  destinationAccount      TreasuryAccount     @relation("TransferDestination", fields: [destinationAccountId], references: [id])
  amount                  Decimal             @db.Decimal(20, 6)
  currencyCode            String              @map("currency_code") @db.Char(3)
  currency                Currency            @relation(fields: [currencyCode], references: [code])
  destinationAmount       Decimal?            @map("destination_amount") @db.Decimal(20, 6)
  destinationCurrencyCode String?             @map("destination_currency_code") @db.Char(3)
  destinationCurrency     Currency?           @relation("TransferDestinationCurrency", fields: [destinationCurrencyCode], references: [code])
  fxRate                  Decimal?            @map("fx_rate") @db.Decimal(20, 10)
  description             String?
  reference               String?
  submittedById           String?             @map("submitted_by_id")
  submittedBy             User?               @relation("TransferSubmittedBy", fields: [submittedById], references: [id])
  submittedAt             DateTime?           @map("submitted_at")
  approvedById            String?             @map("approved_by_id")
  approvedBy              User?               @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  approvedAt              DateTime?           @map("approved_at")
  processedById           String?             @map("processed_by_id")
  processedBy             User?               @relation("TransferProcessedBy", fields: [processedById], references: [id])
  processedAt             DateTime?           @map("processed_at")
  reversedById            String?             @map("reversed_by_id")
  reversedBy              User?               @relation("TransferReversedBy", fields: [reversedById], references: [id])
  reversedAt              DateTime?           @map("reversed_at")
  reversalReasonId        String?             @map("reversal_reason_id")
  reversalReason          ReversalReasonCode? @relation("TransferReversalReason", fields: [reversalReasonId], references: [id])
  journalEntryId          String?             @map("journal_entry_id")
  journalEntry            JournalEntry?       @relation("TransferJournalEntry", fields: [journalEntryId], references: [id])
  reversalJournalEntryId  String?             @map("reversal_journal_entry_id")
  reversalJournalEntry    JournalEntry?       @relation("TransferReversalJournalEntry", fields: [reversalJournalEntryId], references: [id])
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([status])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transfers")
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PROCESSED
  FAILED
  REVERSED
  CANCELLED
}

model Currency {
  id            String       @id @default(cuid())
  code          String       @unique @db.Char(3)
  name          String
  symbol        String?
  type          CurrencyType @default(FIAT)
  decimalPlaces Int          @default(2)
  isBase        Boolean      @default(false) @map("is_base")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  exchangeRatesBase              ExchangeRate[]           @relation("ExchangeRateBase")
  exchangeRatesQuote             ExchangeRate[]           @relation("ExchangeRateQuote")
  productsServices               ProductService[]
  openingBalances                OpeningBalance[]
  accountBalanceSnapshots        AccountBalanceSnapshot[]
  journalLines                   JournalLine[]
  transactions                   Transaction[]
  treasuryAccounts               TreasuryAccount[]
  paymentSchedules               PaymentSchedule[]
  transfers                      Transfer[]
  transfersAsDestinationCurrency Transfer[]               @relation("TransferDestinationCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id                  String                @id @default(cuid())
  baseCurrencyId      String                @map("base_currency_id")
  baseCurrency        Currency              @relation("ExchangeRateBase", fields: [baseCurrencyId], references: [id])
  quoteCurrencyId     String                @map("quote_currency_id")
  quoteCurrency       Currency              @relation("ExchangeRateQuote", fields: [quoteCurrencyId], references: [id])
  rateDate            DateTime              @map("rate_date")
  rate                Decimal               @db.Decimal(20, 10)
  source              String?               @default("MANUAL")
  differenceTreatment FxDifferenceTreatment @default(EXPENSE) @map("difference_treatment")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@unique([baseCurrencyId, quoteCurrencyId, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

model MasterDataChangeRequest {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType      AuditEntityType        @map("entity_type")
  entityId        String?                @map("entity_id")
  proposedChanges Json                   @map("proposed_changes")
  reason          String
  status          MasterDataChangeStatus @default(DRAFT) @map("status")
  requestedById   String                 @map("requested_by_id")
  requestedBy     User                   @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?                @map("approved_by_id")
  approvedBy      User?                  @relation("ChangeRequestApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?              @map("approved_at")
  effectiveDate   DateTime?              @map("effective_date")
  expiresAt       DateTime?              @map("expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  versions MasterDataVersion[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([requestedById])
  @@index([status, effectiveDate])
  @@map("master_data_change_requests")
}

model MasterDataVersion {
  id              String                  @id @default(cuid())
  changeRequestId String                  @map("change_request_id")
  changeRequest   MasterDataChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  entityType      AuditEntityType         @map("entity_type")
  entityId        String?                 @map("entity_id")
  versionNumber   Int                     @map("version_number")
  snapshot        Json                    @map("snapshot")
  changedFields   Json?                   @map("changed_fields")
  effectiveFrom   DateTime                @map("effective_from")
  effectiveTo     DateTime?               @map("effective_to")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@unique([changeRequestId, versionNumber])
  @@index([entityType, entityId])
  @@index([effectiveFrom])
  @@map("master_data_versions")
}

/// Reason codes for transaction categorization (PDF 62). Seeded as reference data.
model ReasonCode {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  category       String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([category, isActive])
  @@map("reason_codes")
}

/// Lightweight product/service catalogue for revenue linkage (PDF 62).
model ProductService {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  type           String // "PRODUCT" | "SERVICE"
  unit           String? // e.g., "HOUR", "DAY", "UNIT", "MONTH"
  unitPrice      Decimal?     @map("unit_price") @db.Decimal(20, 6)
  currencyCode   String?      @map("currency_code") @db.Char(3)
  currency       Currency?    @relation(fields: [currencyCode], references: [code])
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@map("products_services")
}

/// Chart of Accounts — hierarchical, configurable per PDF §7.
model Account {
  id                             String              @id @default(cuid())
  organizationId                 String              @map("organization_id")
  organization                   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                           String
  name                           String
  description                    String?
  type                           AccountType
  subCategory                    AccountSubCategory?
  normalBalance                  NormalBalance
  parentId                       String?             @map("parent_id")
  parent                         Account?            @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                       Account[]           @relation("AccountHierarchy")
  isPostable                     Boolean             @default(true) @map("is_postable")
  isReconcilable                 Boolean             @default(false) @map("is_reconcilable")
  requiresDocument               Boolean             @default(false) @map("requires_document")
  status                         AccountStatus       @default(ACTIVE)
  validatedByQualifiedAccountant Boolean             @default(false) @map("validated_by_qualified_accountant")
  validatorNotes                 String?             @map("validator_notes")
  createdAt                      DateTime            @default(now()) @map("created_at")
  updatedAt                      DateTime            @updatedAt @map("updated_at")

  openingBalances         OpeningBalance[]
  budgetLines             BudgetLine[]
  journalLines            JournalLine[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  transactions            Transaction[]
  treasuryAccounts        TreasuryAccount[]

  @@unique([organizationId, code])
  @@index([parentId])
  @@index([type, status])
  @@map("accounts")
}

/// Financial Periods — monthly/quarterly/annual with lifecycle and reopen control.
model FinancialPeriod {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           PeriodType
  status         PeriodStatus @default(OPEN)
  code           String // e.g., "2025-01", "2025-Q1", "2025"
  name           String
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  isAdjustment   Boolean      @default(false) @map("is_adjustment")
  reopenCount    Int          @default(0) @map("reopen_count")
  closedAt       DateTime?    @map("closed_at")
  lockedAt       DateTime?    @map("locked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  openingBalances         OpeningBalance[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  journalEntries          JournalEntry[]

  @@unique([organizationId, code])
  @@index([status, startDate])
  @@index([type, startDate])
  @@map("financial_periods")
}

/// Opening Balances — one-sided/partial historical entries with verification status (PDF §2).
model OpeningBalance {
  id                     String             @id @default(cuid())
  organizationId         String             @map("organization_id")
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId              String             @map("account_id")
  account                Account            @relation(fields: [accountId], references: [id])
  periodId               String             @map("period_id")
  period                 FinancialPeriod    @relation(fields: [periodId], references: [id])
  amount                 Decimal            @db.Decimal(20, 6)
  currencyCode           String             @map("currency_code") @db.Char(3)
  currency               Currency           @relation(fields: [currencyCode], references: [code])
  isUnverified           Boolean            @default(true) @map("is_unverified")
  verificationStatus     VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedByAccountantAt DateTime?          @map("verified_by_accountant_at")
  verifiedByAccountantId String?            @map("verified_by_accountant_id")
  source                 String // mandatory provenance
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@unique([accountId, periodId])
  @@index([verificationStatus])
  @@map("opening_balances")
}

/// Account Balance Snapshots — rebuildable cache for dashboard speed.
model AccountBalanceSnapshot {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String          @map("account_id")
  account        Account         @relation(fields: [accountId], references: [id])
  periodId       String          @map("period_id")
  period         FinancialPeriod @relation(fields: [periodId], references: [id])
  currencyCode   String          @map("currency_code") @db.Char(3)
  currency       Currency        @relation(fields: [currencyCode], references: [code])
  debitTotal     Decimal         @map("debit_total") @db.Decimal(20, 6)
  creditTotal    Decimal         @map("credit_total") @db.Decimal(20, 6)
  balance        Decimal         @db.Decimal(20, 6)
  computedAt     DateTime        @default(now()) @map("computed_at")

  @@unique([accountId, periodId, currencyCode])
  @@index([periodId])
  @@map("account_balance_snapshots")
}

/// JournalEntry — M4 double-entry core.
model JournalEntry {
  id               String              @id @default(cuid())
  organizationId   String              @map("organization_id")
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodId         String              @map("period_id")
  period           FinancialPeriod     @relation(fields: [periodId], references: [id])
  type             JournalEntryType    @default(STANDARD)
  status           JournalEntryStatus  @default(DRAFT)
  source           JournalSource       @default(MANUAL)
  number           String? // allocated on post
  reference        String?
  description      String?
  transactionId    String?             @map("transaction_id")
  transaction      Transaction?        @relation(fields: [transactionId], references: [id])
  adjustingEntryId String?             @map("adjusting_entry_id")
  adjustingEntry   JournalEntry?       @relation("JournalEntryAdjustments", fields: [adjustingEntryId], references: [id])
  adjustedEntries  JournalEntry[]      @relation("JournalEntryAdjustments")
  reversalReasonId String?             @map("reversal_reason_id")
  reversalReason   ReversalReasonCode? @relation(fields: [reversalReasonId], references: [id])
  reversedEntryId  String?             @map("reversed_entry_id")
  reversedEntry    JournalEntry?       @relation("JournalEntryReversals", fields: [reversedEntryId], references: [id])
  reversingEntries JournalEntry[]      @relation("JournalEntryReversals")
  submittedById    String?             @map("submitted_by_id")
  submittedBy      User?               @relation("JournalEntrySubmittedBy", fields: [submittedById], references: [id])
  submittedAt      DateTime?           @map("submitted_at")
  approvedById     String?             @map("approved_by_id")
  approvedBy       User?               @relation("JournalEntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?           @map("approved_at")
  postedById       String?             @map("posted_by_id")
  postedBy         User?               @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  postedAt         DateTime?           @map("posted_at")
  reversedById     String?             @map("reversed_by_id")
  reversedBy       User?               @relation("JournalEntryReversedBy", fields: [reversedById], references: [id])
  reversedAt       DateTime?           @map("reversed_at")
  voidedById       String?             @map("voided_by_id")
  voidedAt         DateTime?           @map("voided_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  lines             JournalLine[]
  transfers         Transfer[]    @relation("TransferJournalEntry")
  reversalTransfers Transfer[]    @relation("TransferReversalJournalEntry")

  @@unique([organizationId, number])
  @@index([periodId, status])
  @@index([transactionId])
  @@index([adjustingEntryId])
  @@index([reversedEntryId])
  @@index([reversalReasonId])
  @@map("journal_entries")
}

/// JournalLine — M4 double-entry core. Every line belongs to exactly one entry.
model JournalLine {
  id                String           @id @default(cuid())
  organizationId    String           @map("organization_id")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryId           String           @map("entry_id")
  entry             JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId         String           @map("account_id")
  account           Account          @relation(fields: [accountId], references: [id])
  lineNumber        Int              @map("line_number")
  description       String?
  debit             Decimal          @default(0) @db.Decimal(20, 6)
  credit            Decimal          @default(0) @db.Decimal(20, 6)
  currencyCode      String           @map("currency_code") @db.Char(3)
  currency          Currency         @relation(fields: [currencyCode], references: [code])
  baseAmount        Decimal          @map("base_amount") @db.Decimal(20, 6)
  fxRate            Decimal?         @map("fx_rate") @db.Decimal(20, 10)
  projectId         String?          @map("project_id")
  project           Project?         @relation(fields: [projectId], references: [id])
  departmentId      String?          @map("department_id")
  department        Department?      @relation(fields: [departmentId], references: [id])
  costCentreId      String?          @map("cost_centre_id")
  costCentre        CostCentre?      @relation(fields: [costCentreId], references: [id])
  locationId        String?          @map("location_id")
  location          Location?        @relation(fields: [locationId], references: [id])
  fundingSourceId   String?          @map("funding_source_id")
  fundingSource     FundingSource?   @relation(fields: [fundingSourceId], references: [id])
  treasuryAccountId String?          @map("treasury_account_id")
  treasuryAccount   TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id])
  createdAt         DateTime         @default(now()) @map("created_at")

  @@unique([entryId, lineNumber])
  @@index([entryId])
  @@index([accountId])
  @@index([projectId])
  @@index([departmentId])
  @@index([costCentreId])
  @@index([locationId])
  @@index([fundingSourceId])
  @@index([treasuryAccountId])
  @@map("journal_lines")
}

/// Reversal reason codes — seeded reference data for reversal/adjustment audit trail.
model ReversalReasonCode {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  category       String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  journalEntries JournalEntry[]
  transactions   Transaction[]
  transfers      Transfer[]     @relation("TransferReversalReason")

  @@unique([organizationId, code])
  @@index([category, isActive])
  @@map("reversal_reason_codes")
}

/// Transaction — M5 expanded with all PDF §8 fields.
model Transaction {
  id                   String              @id @default(cuid())
  organizationId       String              @map("organization_id")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status               TransactionStatus   @default(DRAFT)
  date                 DateTime            @db.Date
  description          String?
  reference            String?
  number               String? // allocated on post
  accountId            String?             @map("account_id")
  account              Account?            @relation(fields: [accountId], references: [id])
  amount               Decimal             @db.Decimal(20, 6)
  currencyCode         String              @map("currency_code") @db.Char(3)
  currency             Currency            @relation(fields: [currencyCode], references: [code])
  projectId            String?             @map("project_id")
  project              Project?            @relation(fields: [projectId], references: [id])
  departmentId         String?             @map("department_id")
  department           Department?         @relation(fields: [departmentId], references: [id])
  costCentreId         String?             @map("cost_centre_id")
  costCentre           CostCentre?         @relation(fields: [costCentreId], references: [id])
  locationId           String?             @map("location_id")
  location             Location?           @relation(fields: [locationId], references: [id])
  fundingSourceId      String?             @map("funding_source_id")
  fundingSource        FundingSource?      @relation(fields: [fundingSourceId], references: [id])
  treasuryAccountId    String?             @map("treasury_account_id")
  treasuryAccount      TreasuryAccount?    @relation(fields: [treasuryAccountId], references: [id])
  paymentMethod        PaymentMethod       @default(CASH) @map("payment_method")
  supportingDocumentId String?             @map("supporting_document_id") // Document model in M12
  createdById          String?             @map("created_by_id")
  createdBy            User?               @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  submittedById        String?             @map("submitted_by_id")
  submittedBy          User?               @relation("TransactionSubmittedBy", fields: [submittedById], references: [id])
  submittedAt          DateTime?           @map("submitted_at")
  approvedById         String?             @map("approved_by_id")
  approvedBy           User?               @relation("TransactionApprovedBy", fields: [approvedById], references: [id])
  approvedAt           DateTime?           @map("approved_at")
  postedById           String?             @map("posted_by_id")
  postedBy             User?               @relation("TransactionPostedBy", fields: [postedById], references: [id])
  postedAt             DateTime?           @map("posted_at")
  reversedById         String?             @map("reversed_by_id")
  reversedBy           User?               @relation("TransactionReversedBy", fields: [reversedById], references: [id])
  reversedAt           DateTime?           @map("reversed_at")
  voidedById           String?             @map("voided_by_id")
  voidedAt             DateTime?           @map("voided_at")
  reversalReasonId     String?             @map("reversal_reason_id")
  reversalReason       ReversalReasonCode? @relation(fields: [reversalReasonId], references: [id])
  adjustingEntryId     String?             @map("adjusting_entry_id")
  adjustingEntry       Transaction?        @relation("TransactionAdjustments", fields: [adjustingEntryId], references: [id])
  adjustedEntries      Transaction[]       @relation("TransactionAdjustments")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  journalEntries JournalEntry[]

  @@unique([organizationId, number])
  @@index([status, date])
  @@index([accountId])
  @@index([projectId])
  @@index([departmentId])
  @@index([costCentreId])
  @@index([locationId])
  @@index([fundingSourceId])
  @@index([treasuryAccountId])
  @@index([supportingDocumentId])
  @@index([reversalReasonId])
  @@index([adjustingEntryId])
  @@map("transactions")
}

/// Minimal Budget for M3 account relation (expanded in M9).
model Budget {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           BudgetLevel
  status         BudgetStatus     @default(DRAFT)
  periodType     BudgetPeriodType
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

