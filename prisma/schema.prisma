// ============================================================================
// BLECA SmartLabs Finance — Prisma schema
//
// Milestone 1 scope: identity, authentication, RBAC, organisation root, audit.
// Accounting, treasury, budgets and sales models land in M2+.
//
// CONVENTIONS ENFORCED HERE (see PHASE_1_PLAN.md 3.8):
//
//   1. Table and COLUMN names are snake_case via @map/@@map. Prisma's camelCase
//      default is fine until you write raw SQL - and from M1 onward this project
//      writes raw SQL for every guarantee Prisma cannot express (audit
//      append-only, hash-chain linkage, journal immutability, period lock).
//      Quoted "camelCase" identifiers in those triggers would be unreadable and
//      error-prone. Settled now, while there is no data, rather than after go-live.
//
//   2. Money is Decimal(20,6). Never Float.
//
//   3. Every business table carries organization_id for tenant isolation.
//
//   4. Soft delete only. Hard delete is allowed only for import_row,
//      notification, session and idempotency_key after retention expiry.
//
//   5. No Tanzanian tax value and no bank file format may appear in this file.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

