/// Commercial offer. It deliberately has no ledger relation or posting fields:
/// quotations do not recognize revenue.
model Quotation {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String          @map("customer_id")
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  number         String
  status         QuotationStatus @default(DRAFT)
  quoteDate      DateTime        @map("quote_date") @db.Date
  validUntil     DateTime        @map("valid_until") @db.Date
  currencyCode   String          @map("currency_code") @db.Char(3)
  reference      String?
  notes          String?
  subtotal       Decimal         @db.Decimal(20, 6)
  taxAmount      Decimal         @default(0) @map("tax_amount") @db.Decimal(20, 6)
  totalAmount    Decimal         @map("total_amount") @db.Decimal(20, 6)
  submittedById  String?         @map("submitted_by_id")
  submittedAt    DateTime?       @map("submitted_at")
  approvedById   String?         @map("approved_by_id")
  approvedAt     DateTime?       @map("approved_at")
  sentAt         DateTime?       @map("sent_at")
  acceptedAt     DateTime?       @map("accepted_at")
  convertedAt    DateTime?       @map("converted_at")
  createdById    String          @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  lines    QuotationLine[]
  invoices Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, customerId, status, validUntil])
  @@map("quotations")
}

model QuotationLine {
  id               String        @id @default(cuid())
  quotationId      String        @map("quotation_id")
  quotation        Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description      String
  quantity         Decimal       @db.Decimal(20, 6)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(20, 6)
  amount           Decimal       @db.Decimal(20, 6)
  invoicedQuantity Decimal       @default(0) @map("invoiced_quantity") @db.Decimal(20, 6)
  invoiceLines     InvoiceLine[]

  @@index([quotationId])
  @@map("quotation_lines")
}

/// Receivable and payable invoices share one ledger-backed document model.
model Invoice {
  id                     String               @id @default(cuid())
  organizationId         String               @map("organization_id")
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  direction              InvoiceDirection
  customerId             String?              @map("customer_id")
  customer               Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId             String?              @map("supplier_id")
  supplier               Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quotationId            String?              @map("quotation_id")
  quotation              Quotation?           @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  number                 String
  status                 InvoiceStatus        @default(DRAFT)
  invoiceDate            DateTime             @map("invoice_date") @db.Date
  dueDate                DateTime             @map("due_date") @db.Date
  currencyCode           String               @map("currency_code") @db.Char(3)
  reference              String?
  notes                  String?
  subtotal               Decimal              @db.Decimal(20, 6)
  taxAmount              Decimal              @default(0) @map("tax_amount") @db.Decimal(20, 6)
  totalAmount            Decimal              @map("total_amount") @db.Decimal(20, 6)
  taxInvoiceNumber       String?              @map("tax_invoice_number")
  taxInvoiceValid        Boolean              @default(false) @map("tax_invoice_valid")
  taxRulesApplied        Json?                @map("tax_rules_applied")
  isTaxInvoice           Boolean              @default(false) @map("is_tax_invoice")
  journalEntryId         String?              @unique @map("journal_entry_id")
  reversalJournalEntryId String?              @unique @map("reversal_journal_entry_id")
  submittedById          String?              @map("submitted_by_id")
  submittedAt            DateTime?            @map("submitted_at")
  approvedById           String?              @map("approved_by_id")
  approvedAt             DateTime?            @map("approved_at")
  sentAt                 DateTime?            @map("sent_at")
  cancelledAt            DateTime?            @map("cancelled_at")
  cancellationReason     String?              @map("cancellation_reason")
  recurrenceFrequency    RecurrenceFrequency? @map("recurrence_frequency")
  recurrenceNextAt       DateTime?            @map("recurrence_next_at") @db.Date
  recurrenceEndsAt       DateTime?            @map("recurrence_ends_at") @db.Date
  recurrenceTemplateId   String?              @map("recurrence_template_id")
  recurrenceTemplate     Invoice?             @relation("InvoiceRecurrences", fields: [recurrenceTemplateId], references: [id], onDelete: Restrict)
  recurringInvoices      Invoice[]            @relation("InvoiceRecurrences")
  createdById            String               @map("created_by_id")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  receipts    ReceiptLine[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  reminders   InvoiceReminder[]

  @@unique([organizationId, number])
  @@unique([organizationId, taxInvoiceNumber])
  @@unique([organizationId, recurrenceTemplateId, invoiceDate])
  @@index([organizationId, direction, status, dueDate])
  @@index([organizationId, customerId, invoiceDate])
  @@index([organizationId, supplierId, invoiceDate])
  @@map("invoices")
}

model InvoiceLine {
  id              String         @id @default(cuid())
  invoiceId       String         @map("invoice_id")
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quotationLineId String?        @map("quotation_line_id")
  quotationLine   QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: Restrict)
  description     String
  quantity        Decimal        @db.Decimal(20, 6)
  unitPrice       Decimal        @map("unit_price") @db.Decimal(20, 6)
  amount          Decimal        @db.Decimal(20, 6)
  taxRate         Decimal?       @map("tax_rate") @db.Decimal(9, 6)
  taxAmount       Decimal        @default(0) @map("tax_amount") @db.Decimal(20, 6)
  taxAccountId    String?        @map("tax_account_id")
  accountId       String         @map("account_id")

  @@index([invoiceId])
  @@index([quotationLineId])
  @@map("invoice_lines")
}

model InvoiceReminder {
