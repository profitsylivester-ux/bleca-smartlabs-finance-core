model Payment {
  id                     String                @id @default(cuid())
  organizationId         String                @map("organization_id")
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  direction              PaymentDirection
  customerId             String?               @map("customer_id")
  customer               Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId             String?               @map("supplier_id")
  supplier               Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  number                 String
  status                 PaymentStatus         @default(DRAFT)
  treasuryAccountId      String                @map("treasury_account_id")
  treasuryAccount        TreasuryAccount       @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  currencyCode           String                @map("currency_code") @db.Char(3)
  amount                 Decimal               @db.Decimal(20, 6)
  unappliedAmount        Decimal               @default(0) @map("unapplied_amount") @db.Decimal(20, 6)
  allocationMode         PaymentAllocationMode @default(FIFO) @map("allocation_mode")
  onAccountAccountId     String?               @map("on_account_account_id")
  paymentDate            DateTime              @map("payment_date") @db.Date
  reference              String?
  description            String?
  journalEntryId         String?               @unique @map("journal_entry_id")
  reversalJournalEntryId String?               @unique @map("reversal_journal_entry_id")
  submittedById          String?               @map("submitted_by_id")
  submittedAt            DateTime?             @map("submitted_at")
  approvedById           String?               @map("approved_by_id")
  approvedAt             DateTime?             @map("approved_at")
  completedAt            DateTime?             @map("completed_at")
  createdById            String                @map("created_by_id")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  methods     PaymentMethodLine[]
  allocations PaymentAllocation[]
  receipt     Receipt?

  @@unique([organizationId, number])
  @@index([organizationId, direction, status, paymentDate])
  @@index([organizationId, customerId, paymentDate])
  @@index([organizationId, supplierId, paymentDate])
  @@map("payments")
}

model PaymentMethodLine {
  id        String        @id @default(cuid())
  paymentId String        @map("payment_id")
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(20, 6)
  reference String?

  @@index([paymentId])
  @@map("payment_method_lines")
}

model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String   @map("payment_id")
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(20, 6)
  allocatedAt DateTime @default(now()) @map("allocated_at")

  @@unique([paymentId, invoiceId])
  @@index([invoiceId, allocatedAt])
  @@map("payment_allocations")
}

model Receipt {
  id                   String        @id @default(cuid())
  organizationId       String        @map("organization_id")
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId            String        @unique @map("payment_id")
  payment              Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  number               String
  status               ReceiptStatus @default(ISSUED)
  issuedAt             DateTime      @default(now()) @map("issued_at")
  supportingDocumentId String?       @map("supporting_document_id")
  voidedAt             DateTime?     @map("voided_at")
  voidReason           String?       @map("void_reason")
  createdById          String        @map("created_by_id")
  createdAt            DateTime      @default(now()) @map("created_at")

  lines ReceiptLine[]

  @@unique([organizationId, number])
  @@index([organizationId, issuedAt])
  @@map("receipts")
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String  @map("receipt_id")
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(20, 6)

  @@index([receiptId])
  @@index([invoiceId])
  @@map("receipt_lines")
}

model CreditNote {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String               @map("invoice_id")
  invoice        Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  number         String
  status         AdjustmentNoteStatus @default(DRAFT)
  reasonCode     AdjustmentReasonCode @map("reason_code")
  reason         String
  amount         Decimal              @db.Decimal(20, 6)
  taxAmount      Decimal              @default(0) @map("tax_amount") @db.Decimal(20, 6)
  journalEntryId String?              @unique @map("journal_entry_id")
  createdById    String               @map("created_by_id")
  approvedById   String?              @map("approved_by_id")
  approvedAt     DateTime?            @map("approved_at")
  appliedAt      DateTime?            @map("applied_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([invoiceId])
  @@map("credit_notes")
}

model DebitNote {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String               @map("invoice_id")
  invoice        Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  number         String
  status         AdjustmentNoteStatus @default(DRAFT)
  reasonCode     AdjustmentReasonCode @map("reason_code")
  reason         String
  amount         Decimal              @db.Decimal(20, 6)
  taxAmount      Decimal              @default(0) @map("tax_amount") @db.Decimal(20, 6)
  journalEntryId String?              @unique @map("journal_entry_id")
  createdById    String               @map("created_by_id")
  approvedById   String?              @map("approved_by_id")
  approvedAt     DateTime?            @map("approved_at")
  appliedAt      DateTime?            @map("applied_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([invoiceId])
  @@map("debit_notes")
}

/// Chart of Accounts — hierarchical, configurable per PDF §7.
model Account {
  id                             String              @id @default(cuid())
  organizationId                 String              @map("organization_id")
  organization                   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                           String
  name                           String
  description                    String?
  type                           AccountType
  subCategory                    AccountSubCategory?
  normalBalance                  NormalBalance
  parentId                       String?             @map("parent_id")
  parent                         Account?            @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                       Account[]           @relation("AccountHierarchy")
  isPostable                     Boolean             @default(true) @map("is_postable")
  isReconcilable                 Boolean             @default(false) @map("is_reconcilable")
  requiresDocument               Boolean             @default(false) @map("requires_document")
  status                         AccountStatus       @default(ACTIVE)
  validatedByQualifiedAccountant Boolean             @default(false) @map("validated_by_qualified_accountant")
  validatorNotes                 String?             @map("validator_notes")
  createdAt                      DateTime            @default(now()) @map("created_at")
  updatedAt                      DateTime            @updatedAt @map("updated_at")

  openingBalances           OpeningBalance[]
  budgetLines               BudgetLine[]
  commitments               Commitment[]
  journalLines              JournalLine[]
  accountBalanceSnapshots   AccountBalanceSnapshot[]
  transactions              Transaction[]
  treasuryAccounts          TreasuryAccount[]
  reconciliationAdjustments ReconciliationAdjustment[]
  payableTaxRules           TaxRule[]                  @relation("TaxRulePayableAccount")
  receivableTaxRules        TaxRule[]                  @relation("TaxRuleReceivableAccount")

  @@unique([organizationId, code])
  @@index([parentId])
  @@index([type, status])
  @@map("accounts")
}

/// Financial Periods — monthly/quarterly/annual with lifecycle and reopen control.
model FinancialPeriod {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           PeriodType
  status         PeriodStatus @default(OPEN)
  code           String // e.g., "2025-01", "2025-Q1", "2025"
  name           String
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  isAdjustment   Boolean      @default(false) @map("is_adjustment")
  reopenCount    Int          @default(0) @map("reopen_count")
  closedAt       DateTime?    @map("closed_at")
  lockedAt       DateTime?    @map("locked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  openingBalances         OpeningBalance[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  journalEntries          JournalEntry[]
  reconciliationSessions  ReconciliationSession[]

  @@unique([organizationId, code])
  @@index([status, startDate])
  @@index([type, startDate])
  @@map("financial_periods")
}

/// Opening Balances — one-sided/partial historical entries with verification status (PDF §2).
model OpeningBalance {
  id                     String             @id @default(cuid())
  organizationId         String             @map("organization_id")
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId              String             @map("account_id")
  account                Account            @relation(fields: [accountId], references: [id])
  periodId               String             @map("period_id")
  period                 FinancialPeriod    @relation(fields: [periodId], references: [id])
  amount                 Decimal            @db.Decimal(20, 6)
  currencyCode           String             @map("currency_code") @db.Char(3)
  currency               Currency           @relation(fields: [currencyCode], references: [code])
  isUnverified           Boolean            @default(true) @map("is_unverified")
  verificationStatus     VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedByAccountantAt DateTime?          @map("verified_by_accountant_at")
  verifiedByAccountantId String?            @map("verified_by_accountant_id")
  source                 String // mandatory provenance
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@unique([accountId, periodId])
  @@index([verificationStatus])
  @@map("opening_balances")
}

/// Account Balance Snapshots — rebuildable cache for dashboard speed.
model AccountBalanceSnapshot {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String          @map("account_id")
  account        Account         @relation(fields: [accountId], references: [id])
  periodId       String          @map("period_id")
  period         FinancialPeriod @relation(fields: [periodId], references: [id])
  currencyCode   String          @map("currency_code") @db.Char(3)
  currency       Currency        @relation(fields: [currencyCode], references: [code])
  debitTotal     Decimal         @map("debit_total") @db.Decimal(20, 6)
  creditTotal    Decimal         @map("credit_total") @db.Decimal(20, 6)
  balance        Decimal         @db.Decimal(20, 6)
  computedAt     DateTime        @default(now()) @map("computed_at")

  @@unique([accountId, periodId, currencyCode])
  @@index([periodId])
  @@map("account_balance_snapshots")
}

/// JournalEntry — M4 double-entry core.
model JournalEntry {
  id               String              @id @default(cuid())
  organizationId   String              @map("organization_id")
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodId         String              @map("period_id")
  period           FinancialPeriod     @relation(fields: [periodId], references: [id])
  type             JournalEntryType    @default(STANDARD)
  status           JournalEntryStatus  @default(DRAFT)
  source           JournalSource       @default(MANUAL)
  number           String? // allocated on post
  reference        String?
  description      String?
  transactionId    String?             @map("transaction_id")
  transaction      Transaction?        @relation(fields: [transactionId], references: [id])
  adjustingEntryId String?             @map("adjusting_entry_id")
  adjustingEntry   JournalEntry?       @relation("JournalEntryAdjustments", fields: [adjustingEntryId], references: [id])
  adjustedEntries  JournalEntry[]      @relation("JournalEntryAdjustments")
  reversalReasonId String?             @map("reversal_reason_id")
  reversalReason   ReversalReasonCode? @relation(fields: [reversalReasonId], references: [id])
  reversedEntryId  String?             @map("reversed_entry_id")
  reversedEntry    JournalEntry?       @relation("JournalEntryReversals", fields: [reversedEntryId], references: [id])
  reversingEntries JournalEntry[]      @relation("JournalEntryReversals")
  submittedById    String?             @map("submitted_by_id")
  submittedBy      User?               @relation("JournalEntrySubmittedBy", fields: [submittedById], references: [id])
  submittedAt      DateTime?           @map("submitted_at")
  approvedById     String?             @map("approved_by_id")
  approvedBy       User?               @relation("JournalEntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?           @map("approved_at")
  postedById       String?             @map("posted_by_id")
  postedBy         User?               @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  postedAt         DateTime?           @map("posted_at")
  reversedById     String?             @map("reversed_by_id")
  reversedBy       User?               @relation("JournalEntryReversedBy", fields: [reversedById], references: [id])
  reversedAt       DateTime?           @map("reversed_at")
  voidedById       String?             @map("voided_by_id")
  voidedAt         DateTime?           @map("voided_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  lines                     JournalLine[]
  transfers                 Transfer[]                 @relation("TransferJournalEntry")
  reversalTransfers         Transfer[]                 @relation("TransferReversalJournalEntry")
  reconciliationMatches     ReconciliationMatch[]      @relation("ReconciliationMatchJournalEntry")
  reconciliationAdjustments ReconciliationAdjustment[] @relation("ReconciliationAdjustmentJournalEntry")
  taxPayments               TaxPayment[]

  @@unique([organizationId, number])
  @@index([periodId, status])
  @@index([transactionId])
  @@index([adjustingEntryId])
  @@index([reversedEntryId])
  @@index([reversalReasonId])
  @@map("journal_entries")
}

/// JournalLine — M4 double-entry core. Every line belongs to exactly one entry.
model JournalLine {
  id                String           @id @default(cuid())
  organizationId    String           @map("organization_id")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryId           String           @map("entry_id")
  entry             JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId         String           @map("account_id")
  account           Account          @relation(fields: [accountId], references: [id])
  lineNumber        Int              @map("line_number")
  description       String?
  debit             Decimal          @default(0) @db.Decimal(20, 6)
  credit            Decimal          @default(0) @db.Decimal(20, 6)
  currencyCode      String           @map("currency_code") @db.Char(3)
  currency          Currency         @relation(fields: [currencyCode], references: [code])
  baseAmount        Decimal          @map("base_amount") @db.Decimal(20, 6)
  fxRate            Decimal?         @map("fx_rate") @db.Decimal(20, 10)
  projectId         String?          @map("project_id")
  project           Project?         @relation(fields: [projectId], references: [id])
  departmentId      String?          @map("department_id")
  department        Department?      @relation(fields: [departmentId], references: [id])
  costCentreId      String?          @map("cost_centre_id")
  costCentre        CostCentre?      @relation(fields: [costCentreId], references: [id])
  locationId        String?          @map("location_id")
  location          Location?        @relation(fields: [locationId], references: [id])
  fundingSourceId   String?          @map("funding_source_id")
  fundingSource     FundingSource?   @relation(fields: [fundingSourceId], references: [id])
  treasuryAccountId String?          @map("treasury_account_id")
  treasuryAccount   TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id])
  createdAt         DateTime         @default(now()) @map("created_at")

  @@unique([entryId, lineNumber])
  @@index([entryId])
  @@index([accountId])
  @@index([projectId])
  @@index([departmentId])
  @@index([costCentreId])
  @@index([locationId])
  @@index([fundingSourceId])
  @@index([treasuryAccountId])
  @@map("journal_lines")
}

/// Reversal reason codes — seeded reference data for reversal/adjustment audit trail.
model ReversalReasonCode {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  category       String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  journalEntries JournalEntry[]
  transactions   Transaction[]
  transfers      Transfer[]     @relation("TransferReversalReason")

  @@unique([organizationId, code])
  @@index([category, isActive])
  @@map("reversal_reason_codes")
}

/// Transaction — M5 expanded with all PDF §8 fields.
model Transaction {
  id                   String              @id @default(cuid())
  organizationId       String              @map("organization_id")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status               TransactionStatus   @default(DRAFT)
  date                 DateTime            @db.Date
  description          String?
  reference            String?
  number               String? // allocated on post
  accountId            String?             @map("account_id")
  account              Account?            @relation(fields: [accountId], references: [id])
  amount               Decimal             @db.Decimal(20, 6)
  currencyCode         String              @map("currency_code") @db.Char(3)
  currency             Currency            @relation(fields: [currencyCode], references: [code])
  projectId            String?             @map("project_id")
  project              Project?            @relation(fields: [projectId], references: [id])
  departmentId         String?             @map("department_id")
  department           Department?         @relation(fields: [departmentId], references: [id])
  costCentreId         String?             @map("cost_centre_id")
  costCentre           CostCentre?         @relation(fields: [costCentreId], references: [id])
  locationId           String?             @map("location_id")
  location             Location?           @relation(fields: [locationId], references: [id])
  fundingSourceId      String?             @map("funding_source_id")
  fundingSource        FundingSource?      @relation(fields: [fundingSourceId], references: [id])
  treasuryAccountId    String?             @map("treasury_account_id")
  treasuryAccount      TreasuryAccount?    @relation(fields: [treasuryAccountId], references: [id])
  paymentMethod        PaymentMethod       @default(CASH) @map("payment_method")
  supportingDocumentId String?             @map("supporting_document_id")
  supportingDocument   Document?           @relation("TransactionSupportingDocument", fields: [supportingDocumentId], references: [id], onDelete: SetNull)
  createdById          String?             @map("created_by_id")
  createdBy            User?               @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  submittedById        String?             @map("submitted_by_id")
  submittedBy          User?               @relation("TransactionSubmittedBy", fields: [submittedById], references: [id])
  submittedAt          DateTime?           @map("submitted_at")
  approvedById         String?             @map("approved_by_id")
  approvedBy           User?               @relation("TransactionApprovedBy", fields: [approvedById], references: [id])
  approvedAt           DateTime?           @map("approved_at")
  postedById           String?             @map("posted_by_id")
  postedBy             User?               @relation("TransactionPostedBy", fields: [postedById], references: [id])
  postedAt             DateTime?           @map("posted_at")
  reversedById         String?             @map("reversed_by_id")
  reversedBy           User?               @relation("TransactionReversedBy", fields: [reversedById], references: [id])
  reversedAt           DateTime?           @map("reversed_at")
  voidedById           String?             @map("voided_by_id")
  voidedAt             DateTime?           @map("voided_at")
  reversalReasonId     String?             @map("reversal_reason_id")
  reversalReason       ReversalReasonCode? @relation(fields: [reversalReasonId], references: [id])
  adjustingEntryId     String?             @map("adjusting_entry_id")
  adjustingEntry       Transaction?        @relation("TransactionAdjustments", fields: [adjustingEntryId], references: [id])
  adjustedEntries      Transaction[]       @relation("TransactionAdjustments")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  journalEntries           JournalEntry[]
  reconciliationMatches    ReconciliationMatch[]
  reconciliationExceptions ReconciliationException[]

  @@unique([organizationId, number])
  @@index([status, date])
  @@index([accountId])
  @@index([projectId])
  @@index([departmentId])
  @@index([costCentreId])
  @@index([locationId])
  @@index([fundingSourceId])
  @@index([treasuryAccountId])
  @@index([supportingDocumentId])
  @@index([reversalReasonId])
  @@index([adjustingEntryId])
  @@map("transactions")
}

/// Budget (M9, PDF §13). A budget is scoped to exactly one level
/// (company / department / project / funding-restricted / activity) via `type`
/// plus the matching dimension column. Availability is recomputed on posting
/// and on every commitment change:  Available = Approved − Commitments − Actual.
///
/// The committed/actual/available columns are a cache for list and detail views.
/// They are never authoritative — `recomputeAvailability` derives them from the
/// budget lines, open commitments and posted journal lines, so a stale cache can
/// always be rebuilt and can never drift silently.
model Budget {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  type           BudgetLevel
  status         BudgetStatus     @default(DRAFT)
  periodType     BudgetPeriodType
  startDate      DateTime         @map("start_date")
  endDate        DateTime         @map("end_date")

  /// The single dimension this budget is scoped to. Exactly one is non-null for
  /// DEPARTMENT/PROJECT/FUNDING/ACTIVITY levels; all null for a COMPANY budget.
  departmentId    String?        @map("department_id")
  department      Department?    @relation(fields: [departmentId], references: [id])
  projectId       String?        @map("project_id")
  project         Project?       @relation(fields: [projectId], references: [id])
  fundingSourceId String?        @map("funding_source_id")
  fundingSource   FundingSource? @relation(fields: [fundingSourceId], references: [id])
  costCentreId    String?        @map("cost_centre_id")
  costCentre      CostCentre?    @relation(fields: [costCentreId], references: [id])
  activity        String? // free-text activity label for ACTIVITY-level budgets

  currencyCode String   @map("currency_code") @db.Char(3)
  currency     Currency @relation(fields: [currencyCode], references: [code])

  /// Cached roll-ups across lines (never authoritative — see class note).
  approvedAmount  Decimal @default(0) @map("approved_amount") @db.Decimal(20, 6)
  committedAmount Decimal @default(0) @map("committed_amount") @db.Decimal(20, 6)
  actualAmount    Decimal @default(0) @map("actual_amount") @db.Decimal(20, 6)
  availableAmount Decimal @default(0) @map("available_amount") @db.Decimal(20, 6)
  isOverBudget    Boolean @default(false) @map("is_over_budget")

  createdById  String?   @map("created_by_id")
  createdBy    User?     @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  approvedById String?   @map("approved_by_id")
  approvedBy   User?     @relation("BudgetApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")
  activatedAt  DateTime? @map("activated_at")
  closedAt     DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines       BudgetLine[]
  revisions   BudgetRevision[]
  transfers   BudgetTransfer[]
  commitments Commitment[]
  scenarios   BudgetScenario[]

  @@unique([organizationId, code])
  @@index([status])
  @@index([type, status])
  @@index([projectId])
  @@index([departmentId])
  @@index([fundingSourceId])
  @@map("budgets")
}

/// BudgetLine (M9). One account's approved amount within a budget, with optional
/// monthly phasing. Committed/actual/available are caches recomputed by
/// `recomputeAvailability`; the formula is Available = Approved − Commitments − Actual.
model BudgetLine {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String       @map("budget_id")
  budget         Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id])
  description    String?
  amount         Decimal      @db.Decimal(20, 6)
  /// Optional monthly phasing for a MONTHLY budget: { "1": "1000", "2": "0", ... }.
  /// Stored as JSON in base currency; validated to sum to `amount` by the service.
  phasing        Json?

  /// Cached availability figures (never authoritative — see Budget class note).
  committedAmount Decimal @default(0) @map("committed_amount") @db.Decimal(20, 6)
  actualAmount    Decimal @default(0) @map("actual_amount") @db.Decimal(20, 6)
  availableAmount Decimal @default(0) @map("available_amount") @db.Decimal(20, 6)
  isOverBudget    Boolean @default(false) @map("is_over_budget")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commitments   Commitment[]
  revisionLines BudgetRevisionLine[]
  transfersFrom BudgetTransfer[]     @relation("TransferFromLine")
  transfersTo   BudgetTransfer[]     @relation("TransferToLine")

  @@unique([budgetId, accountId])
  @@index([accountId])
  @@map("budget_lines")
}

/// Commitment (M9, PDF §67). A commitment reserves budget ahead of actual spend
/// (an invoice raised, a payment scheduled, a contract signed, a manual entry).
/// `source` records where it came from and `sourceId` the originating document,
/// so a commitment created from an invoice can be traced back and settled when
/// the invoice is paid. Creating a commitment reserves budget; settling or
/// cancelling it releases the reservation.
model Commitment {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String?      @map("budget_id")
  budget         Budget?      @relation(fields: [budgetId], references: [id])
  budgetLineId   String?      @map("budget_line_id")
  budgetLine     BudgetLine?  @relation(fields: [budgetLineId], references: [id])
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id])

  source         CommitmentSource
  sourceId       String?          @map("source_id")
  description    String?
  amount         Decimal          @db.Decimal(20, 6)
  currencyCode   String           @map("currency_code") @db.Char(3)
  currency       Currency         @relation(fields: [currencyCode], references: [code])
  status         CommitmentStatus @default(OPEN)
  commitmentDate DateTime         @map("commitment_date")
  expectedDate   DateTime?        @map("expected_date")

  projectId       String?        @map("project_id")
  project         Project?       @relation(fields: [projectId], references: [id])
  departmentId    String?        @map("department_id")
  department      Department?    @relation(fields: [departmentId], references: [id])
  fundingSourceId String?        @map("funding_source_id")
  fundingSource   FundingSource? @relation(fields: [fundingSourceId], references: [id])

  settledAt   DateTime? @map("settled_at")
  releasedAt  DateTime? @map("released_at")
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("CommitmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([budgetId, status])
  @@index([budgetLineId, status])
  @@index([status, expectedDate])
  @@index([commitmentDate])
  @@index([accountId])
  @@index([source, sourceId])
  @@map("commitments")
}

/// BudgetRevision (M9). Approval-gated; each revision carries line-level
/// before/after snapshots so the full history of every change is preserved.
model BudgetRevision {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String               @map("budget_id")
  budget         Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  revisionNumber Int                  @map("revision_number")
  reason         String
  status         BudgetRevisionStatus @default(DRAFT)

  createdById  String?   @map("created_by_id")
  createdBy    User?     @relation("BudgetRevisionCreatedBy", fields: [createdById], references: [id])
  submittedAt  DateTime? @map("submitted_at")
  approvedById String?   @map("approved_by_id")
  approvedBy   User?     @relation("BudgetRevisionApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")
  rejectedAt   DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines BudgetRevisionLine[]

  @@unique([budgetId, revisionNumber])
  @@index([budgetId, status])
  @@map("budget_revisions")
}

/// BudgetRevisionLine (M9). The before/after snapshot of one line within a
/// revision. `beforeAmount` is captured at revision creation; `afterAmount` is
/// what the line becomes once the revision is approved.
model BudgetRevisionLine {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  revisionId     String         @map("revision_id")
  revision       BudgetRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  budgetLineId   String         @map("budget_line_id")
  budgetLine     BudgetLine     @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  accountId      String         @map("account_id")
  beforeAmount   Decimal        @map("before_amount") @db.Decimal(20, 6)
  afterAmount    Decimal        @map("after_amount") @db.Decimal(20, 6)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([revisionId, budgetLineId])
  @@index([budgetLineId])
  @@map("budget_revision_lines")
}

/// BudgetTransfer (M9). Moves an approved amount between two lines of the same
/// budget. Approval-gated and audited; applying it decrements the from-line and
/// increments the to-line, then recomputes availability on both.
model BudgetTransfer {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String               @map("budget_id")
  budget         Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  transferNumber Int                  @map("transfer_number")
  fromLineId     String               @map("from_line_id")
  fromLine       BudgetLine           @relation("TransferFromLine", fields: [fromLineId], references: [id])
  toLineId       String               @map("to_line_id")
  toLine         BudgetLine           @relation("TransferToLine", fields: [toLineId], references: [id])
  amount         Decimal              @db.Decimal(20, 6)
  reason         String
  status         BudgetTransferStatus @default(DRAFT)

  createdById  String?   @map("created_by_id")
  createdBy    User?     @relation("BudgetTransferCreatedBy", fields: [createdById], references: [id])
  approvedById String?   @map("approved_by_id")
  approvedBy   User?     @relation("BudgetTransferApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")
  appliedAt    DateTime? @map("applied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([budgetId, transferNumber])
  @@index([budgetId, status])
  @@map("budget_transfers")
}

/// BudgetScenario (M9, PDF §13). Lightweight, non-destructive scenario planning
/// (best / expected / worst case). A scenario stores an adjustment factor and a
/// note; projecting it never mutates the underlying budget lines.
model BudgetScenario {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId         String       @map("budget_id")
  budget           Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  kind             ScenarioKind
  name             String
  description      String?
  adjustmentFactor Decimal      @map("adjustment_factor") @db.Decimal(20, 6)
  createdById      String?      @map("created_by_id")
  createdBy        User?        @relation("BudgetScenarioCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([budgetId])
  @@map("budget_scenarios")
}

model OrganizationMembership {
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

// ============================================================================
// B4. AUDIT TRAIL   (PDF 54, PHASE_1_PLAN.md 7)
// ============================================================================

/// Append-only. There is no update path and no delete path - enforced by
/// database triggers (prisma/migrations/*_audit_guards), not by convention.
model AuditLog {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")

  /// Total ordering across the chain.
  sequence            BigInt  @unique @default(autoincrement())
  previousHash        String? @map("previous_hash")
  /// sha256(previous_hash || sequence || actor_id || action || entity_type ||
  /// entity_id || changes || occurred_at).
  entryHash           String  @unique @map("entry_hash")
  /// HMAC-SHA256 over entry_hash with the period key (PHASE_1_PLAN.md 3.8.5).
  signature           String
  /// Which key signed this entry, so rotation stays auditable.
  signatureKeyVersion Int     @default(1) @map("signature_key_version")

  actorId        String?  @map("actor_id")
  /// Denormalised so the record survives user deletion.
  actorName      String?  @map("actor_name")
  /// Roles held at action time - survives later role changes.
  actorRoleCodes String[] @default([]) @map("actor_role_codes")

  action      AuditAction
  entityType  AuditEntityType @map("entity_type")
  entityId    String?         @map("entity_id")
  entityLabel String?         @map("entity_label")
  description String
  /// { field: { from, to } } for every mutated field.
  changes     Json?
  metadata    Json?

  ipAddress    String?      @map("ip_address")
  userAgent    String?      @map("user_agent")
  requestId    String?      @map("request_id")
  sessionId    String?      @map("session_id")
  channel      AuditChannel @default(WEB)
  result       AuditResult  @default(SUCCESS)
  errorMessage String?      @map("error_message")

  /// Event time. Client-supplied for offline sync, which is why divergence from
  /// recorded_at is itself a signal.
  occurredAt DateTime @map("occurred_at")
  /// Server write time.
  recordedAt DateTime @default(now()) @map("recorded_at")

  securityEvents SecurityEvent[]

  @@index([organizationId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
  @@index([result, occurredAt])
  @@index([requestId])
  @@map("audit_logs")
}

/// The single mutable row that anchors the hash chain. SELECT ... FOR UPDATE on
/// this row serialises concurrent audit appends, which is what makes the chain
/// gap-free: an aborted transaction rolls back the audit row and the head update
/// together, so a sequence number can never be consumed by a lost write.
model AuditChainHead {
  id        Int      @id @default(1)
  sequence  BigInt   @default(0)
  entryHash String   @default("") @map("entry_hash")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_chain_head")
}

/// Daily seals. Verification is incremental: start from the last checkpoint
/// rather than replaying the whole chain every night.
model AuditChainCheckpoint {
  id                    String                  @id @default(cuid())
  periodStart           DateTime                @map("period_start")
  periodEnd             DateTime                @map("period_end")
  sealedThroughSequence BigInt                  @map("sealed_through_sequence")
  sealedEntryHash       String                  @map("sealed_entry_hash")
  sealedAt              DateTime                @default(now()) @map("sealed_at")
  verifiedAt            DateTime?               @map("verified_at")
  status                ChainVerificationStatus @default(PENDING)
  entriesChecked        Int                     @default(0) @map("entries_checked")
  brokenAtSequence      BigInt?                 @map("broken_at_sequence")
  detail                String?

  @@index([periodEnd])
  @@index([status])
  @@map("audit_chain_checkpoints")
}

model SecurityEvent {
  id                  String                @id @default(cuid())
  organizationId      String?               @map("organization_id")
  auditLogId          String?               @map("audit_log_id")
  auditLog            AuditLog?             @relation(fields: [auditLogId], references: [id], onDelete: SetNull)
  type                SecurityEventType
  severity            SecurityEventSeverity
  /// The subject is the RECORD, not a person (PDF 65). Kept deliberately: see
  /// AnomalyFlag in M16, which has no accused-user column at all for this reason.
  subjectType         AuditEntityType?      @map("subject_type")
  subjectId           String?               @map("subject_id")
  subjectLabel        String?               @map("subject_label")
  description         String
  detail              Json?
  ipAddress           String?               @map("ip_address")
  userAgent           String?               @map("user_agent")
  requestId           String?               @map("request_id")
  /// Acknowledged by a named human before it has any effect on anything.
  acknowledgedAt      DateTime?             @map("acknowledged_at")
  acknowledgedById    String?               @map("acknowledged_by_id")
  acknowledgementNote String?               @map("acknowledgement_note")
  resolvedAt          DateTime?             @map("resolved_at")
  occurredAt          DateTime              @default(now()) @map("occurred_at")

  @@index([severity, occurredAt])
  @@index([type, occurredAt])
  @@index([acknowledgedAt])
  @@map("security_events")
}

/// Import Pipeline models (PDF §52) — M8
/// Seven-stage gated pipeline: Upload → Map Fields → Validate → Preview → Detect Duplicates → Approve → Import
enum ImportSource {
  EXCEL
  CSV
  API
  MANUAL
}

enum ImportBatchStatus {
  UPLOADED
  MAPPING
  VALIDATING
  PREVIEW
  AWAITING_APPROVAL
  APPROVED
  IMPORTING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  ROLLED_BACK
}

enum ImportErrorType {
  VALIDATION
  DUPLICATE
  MAPPING
  PERMISSION
  SYSTEM
  PARSE
}

// ---- Reconciliation (M8) ----------------------------------------------------

/// What a session is reconciling. Derived from the treasury account kind, but
/// stored explicitly: a bank account can be reconciled against a statement,
/// against the ledger, or against both, and the report must state which.
enum ReconciliationTarget {
  BANK_STATEMENT
  LEDGER
  MOBILE_MONEY
  PAYMENT_GATEWAY
  CASH
}

enum ReconciliationStatus {
  NOT_STARTED
  IN_PROGRESS
  MATCHED
  AWAITING_APPROVAL
  APPROVED
  LOCKED
  REOPENED
  CANCELLED
}

/// How a match was produced. EXACT through MANY_TO_ONE are machine strategies;
/// MANUAL means a human paired them with no rule involved.
enum MatchType {
  EXACT
  DATE_WINDOW
  AMOUNT_TOLERANCE
  REFERENCE_SIMILARITY
  ONE_TO_MANY
  MANY_TO_ONE
  MANUAL
}

/// Lifecycle of a single match row.
///
/// PROPOSED is the only status auto-match may write. Moving to MATCHED requires
/// a human decision via POST /matches/:id/confirm — there is no path that
/// promotes a proposal automatically, by design.
enum ReconciliationLineStatus {
  PROPOSED
  MATCHED
  REJECTED
  EXCEPTION
  RESOLVED
}

/// Why a statement line or ledger item could not be matched.
enum ReconciliationExceptionType {
  UNMATCHED_STATEMENT_LINE
  UNMATCHED_LEDGER_ENTRY
  AMOUNT_DIFFERENCE
  DATE_DIFFERENCE
  DUPLICATE_SUSPECTED
  LOW_CONFIDENCE
  UNSUPPORTED_ITEM
  TIMING_DIFFERENCE
}

enum ReconciliationExceptionStatus {
  OPEN
  RESOLVED
  WAIVED
}

enum ReconciliationAdjustmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  REVERSED
}

model ImportBatch {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String // e.g., "IMP-2025-001"
  source         ImportSource
  fileName       String            @map("file_name")
  fileHash       String            @map("file_hash") // SHA256 for duplicate detection
  fileSize       Int               @map("file_size")
  mimeType       String            @map("mime_type")
  status         ImportBatchStatus @default(UPLOADED)
  totalRows      Int               @default(0) @map("total_rows")
  validRows      Int               @default(0) @map("valid_rows")
  errorRows      Int               @default(0) @map("error_rows")
  duplicateRows  Int               @default(0) @map("duplicate_rows")
  uploadedById   String            @map("uploaded_by_id")
  uploadedBy     User              @relation("ImportBatchUploadedBy", fields: [uploadedById], references: [id])
  mappedById     String?           @map("mapped_by_id")
  mappedBy       User?             @relation("ImportBatchMappedBy", fields: [mappedById], references: [id])
  validatedById  String?           @map("validated_by_id")
  validatedBy    User?             @relation("ImportBatchValidatedBy", fields: [validatedById], references: [id])
  approvedById   String?           @map("approved_by_id")
  approvedBy     User?             @relation("ImportBatchApprovedBy", fields: [approvedById], references: [id])
  importedById   String?           @map("imported_by_id")
  importedBy     User?             @relation("ImportBatchImportedBy", fields: [importedById], references: [id])
  rolledBackById String?           @map("rolled_back_by_id")
  rolledBackBy   User?             @relation("ImportBatchRolledBackBy", fields: [rolledBackById], references: [id])
  approvedAt     DateTime?         @map("approved_at")
  importedAt     DateTime?         @map("imported_at")
  rolledBackAt   DateTime?         @map("rolled_back_at")
  errorSummary   Json?             @map("error_summary")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  rows                   ImportRow[]
  fieldMappings          ImportFieldMapping[]
  errors                 ImportError[]
  reconciliationSessions ReconciliationSession[]

  @@unique([organizationId, code])
  @@unique([organizationId, fileHash])
  @@index([status])
  @@index([uploadedById])
  @@map("import_batches")
}

model ImportRow {
  id                    String      @id @default(cuid())
  batchId               String      @map("batch_id")
  batch                 ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber             Int         @map("row_number")
  rawData               Json        @map("raw_data") // Original row data verbatim
  mappedData            Json?       @map("mapped_data") // After field mapping
  normalizedData        Json?       @map("normalized_data") // After normalization (dates, amounts)
  status                String      @default("PENDING") // PENDING, VALID, ERROR, DUPLICATE, SKIPPED
  fingerprint           String? // Normalized hash for duplicate detection
  importedTransactionId String?     @map("imported_transaction_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  errors                   ImportError[]
  reconciliationMatches    ReconciliationMatch[]
  reconciliationExceptions ReconciliationException[]

  @@index([batchId, status])
  @@index([batchId, fingerprint])
  @@map("import_rows")
}

model ImportFieldMapping {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId           String?      @map("batch_id") // Null = global default for source
  batch             ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  source            ImportSource
  name              String // e.g., "CRDB Bank TZS CSV"
  description       String?
  dateFormat        String       @map("date_format") // e.g., "yyyy-MM-dd", "dd/MM/yyyy"
  amountConvention  String       @map("amount_convention") // SINGLE_DEBIT_CREDIT | SEPARATE_DEBIT_CREDIT | SIGNED_SINGLE
  decimalSeparator  String       @default(".") @map("decimal_separator")
  thousandSeparator String       @default(",") @map("thousand_separator")
  encoding          String       @default("UTF-8")
  hasHeader         Boolean      @default(true) @map("has_header")
  columnMap         Json         @map("column_map") // { date: 0, description: 1, debit: 2, credit: 3, reference: 4 }
  isDefault         Boolean      @default(false) @map("is_default")
  createdById       String       @map("created_by_id")
  createdBy         User         @relation("ImportFieldMappingCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, source, name])
  @@index([organizationId, source, isDefault])
  @@map("import_field_mappings")
}

model ImportError {
  id             String          @id @default(cuid())
  batchId        String          @map("batch_id")
  batch          ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowId          String?         @map("row_id")
  row            ImportRow?      @relation(fields: [rowId], references: [id], onDelete: SetNull)
  rowNumber      Int             @map("row_number")
  type           ImportErrorType
  field          String? // Which column/field failed
  originalValue  Json?           @map("original_value") // The raw value that failed
  message        String
  severity       String          @default("ERROR") // ERROR | WARNING
  resolved       Boolean         @default(false)
  resolvedById   String?         @map("resolved_by_id")
  resolvedBy     User?           @relation("ImportErrorResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?       @map("resolved_at")
  resolutionNote String?         @map("resolution_note")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([batchId, resolved])
  @@index([batchId, rowNumber])
  @@map("import_errors")
}

// ============================================================================
// B4b. RECONCILIATION (M8) — PDF §12
// ============================================================================
//
// The invariant this whole section exists to enforce: a match proposed by the
// engine and a match asserted by a human are different facts with different
// authority. auto-match writes ReconciliationLineStatus.PROPOSED and nothing
// else may. Only POST /matches/:id/confirm promotes a row to MATCHED, so a
// reconciliation that reaches APPROVED has been vouched for line by line.

/// A reusable matching strategy. Rules are ordered and the engine walks them in
/// priority order, stopping at the first that produces a proposal per line.
model MatchingRule {
  id                  String               @id @default(cuid())
  organizationId      String               @map("organization_id")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  ruleType            MatchType
  target              ReconciliationTarget
  /// +/- whole days either side of the statement date that still counts as a hit.
  dateWindowDays      Int                  @default(3) @map("date_window_days")
  /// +/- absolute amount difference tolerated, in the session currency.
  amountTolerance     Decimal              @default(0) @map("amount_tolerance") @db.Decimal(20, 6)
  /// 0-100. Reference text similarity required by REFERENCE_SIMILARITY.
  similarityThreshold Int                  @default(80) @map("similarity_threshold")
  /// Lower runs first. Ties broken by id so ordering is stable across runs.
  priority            Int                  @default(100)
  isActive            Boolean              @default(true) @map("is_active")
  createdById         String?              @map("created_by_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId, target, isActive, priority])
  @@map("matching_rules")
}

/// One reconciliation run: one treasury account, one period, one target.
model ReconciliationSession {
  id                      String               @id @default(cuid())
  organizationId          String               @map("organization_id")
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  treasuryAccountId       String               @map("treasury_account_id")
  treasuryAccount         TreasuryAccount      @relation(fields: [treasuryAccountId], references: [id])
  /// The statement import being reconciled, when the target is a file.
  importId                String?              @map("import_id")
  import                  ImportBatch?         @relation(fields: [importId], references: [id])
  periodId                String?              @map("period_id")
  period                  FinancialPeriod?     @relation(fields: [periodId], references: [id])
  code                    String
  target                  ReconciliationTarget
  status                  ReconciliationStatus @default(NOT_STARTED)
  statementStartDate      DateTime?            @map("statement_start_date") @db.Date
  statementEndDate        DateTime?            @map("statement_end_date") @db.Date
  statementOpeningBalance Decimal?             @map("statement_opening_balance") @db.Decimal(20, 6)
  statementClosingBalance Decimal?             @map("statement_closing_balance") @db.Decimal(20, 6)
  bookBalanceBeginning    Decimal?             @map("book_balance_beginning") @db.Decimal(20, 6)
  bookBalanceEnding       Decimal?             @map("book_balance_ending") @db.Decimal(20, 6)
  /// opening + net matched movement, recomputed on every confirm.
  calculatedEndingBalance Decimal?             @map("calculated_ending_balance") @db.Decimal(20, 6)
  /// statementClosingBalance - calculatedEndingBalance. Approve requires 0.
  difference              Decimal?             @db.Decimal(20, 6)
  currency                String               @db.Char(3)
  /// Snapshot of the rules and thresholds the last run used, so a later run
  /// under different config cannot be confused with this one.
  matchingRulesApplied    Json?                @map("matching_rules_applied")
  autoMatchThreshold      Int                  @default(85) @map("auto_match_threshold")
  startedById             String?              @map("started_by_id")
  startedAt               DateTime?
  reviewedById            String?              @map("reviewed_by_id")
  reviewedAt              DateTime?            @map("reviewed_at")
  approvedById            String?              @map("approved_by_id")
  approvedAt              DateTime?            @map("approved_at")
  lockedAt                DateTime?            @map("locked_at")
  reopenedAt              DateTime?            @map("reopened_at")
  reopenReason            String?              @map("reopen_reason")
  reopenCount             Int                  @default(0) @map("reopen_count")
  notes                   String?
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  matches     ReconciliationMatch[]
  exceptions  ReconciliationException[]
  adjustments ReconciliationAdjustment[]

  @@unique([organizationId, code])
  @@unique([organizationId, treasuryAccountId, statementStartDate, statementEndDate])
  @@index([status])
  @@index([periodId])
  @@index([treasuryAccountId])
  @@map("reconciliation_sessions")
}

/// A proposed or confirmed pairing between a statement line and a book entry.
///
/// One-to-many and many-to-one are expressed as several rows sharing a
/// matchGroupId: the group is the unit that must be confirmed together, because
/// approving only half of a split would unbalance the reconciliation.
model ReconciliationMatch {
  id               String                   @id @default(cuid())
  organizationId   String                   @map("organization_id")
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId        String                   @map("session_id")
  session          ReconciliationSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Set when this row is one leg of a one-to-many / many-to-one pairing.
  matchGroupId     String?                  @map("match_group_id")
  importRowId      String?                  @map("import_row_id")
  importRow        ImportRow?               @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  transactionId    String?                  @map("transaction_id")
  transaction      Transaction?             @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  journalEntryId   String?                  @map("journal_entry_id")
  journalEntry     JournalEntry?            @relation("ReconciliationMatchJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  matchType        MatchType                @default(MANUAL)
  status           ReconciliationLineStatus @default(PROPOSED)
  /// The statement-side amount. Positive = money in.
  statementAmount  Decimal                  @default(0) @map("statement_amount") @db.Decimal(20, 6)
  /// The book-side amount, in the same sign convention.
  ledgerAmount     Decimal                  @default(0) @map("ledger_amount") @db.Decimal(20, 6)
  /// How much of the statement line this row actually explains. For a split
  /// match this is the leg's share, not the whole line.
  matchedAmount    Decimal                  @map("matched_amount") @db.Decimal(20, 6)
  /// statementAmount - ledgerAmount for this row.
  differenceAmount Decimal                  @default(0) @map("difference_amount") @db.Decimal(20, 6)
  /// 0-100, engine confidence. Null for MANUAL, which has no score to report.
  confidence       Int?
  matchedRuleId    String?                  @map("matched_rule_id")
  differenceReason String?                  @map("difference_reason")
  isManual         Boolean                  @default(false) @map("is_manual")
  matchedById      String?                  @map("matched_by_id")
  matchedAt        DateTime?                @map("matched_at")
  confirmedById    String?                  @map("confirmed_by_id")
  confirmedAt      DateTime?                @map("confirmed_at")
  rejectedById     String?                  @map("rejected_by_id")
  rejectedAt       DateTime?                @map("rejected_at")
  rejectionReason  String?                  @map("rejection_reason")
  notes            String?
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([sessionId, status])
  @@index([sessionId, matchGroupId])
  @@index([importRowId])
  @@index([transactionId])
  @@index([journalEntryId])
  @@map("reconciliation_matches")
}

/// Anything the engine could not pair, or paired below the confidence floor.
/// The exception queue is what a human works through after auto-match.
model ReconciliationException {
  id                  String                        @id @default(cuid())
  organizationId      String                        @map("organization_id")
  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId           String                        @map("session_id")
  session             ReconciliationSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  importRowId         String?                       @map("import_row_id")
  importRow           ImportRow?                    @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  transactionId       String?                       @map("transaction_id")
  transaction         Transaction?                  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  exceptionType       ReconciliationExceptionType   @map("exception_type")
  severity            String                        @default("MEDIUM") // LOW | MEDIUM | HIGH
  /// Signed amount at stake, session currency. Lets the queue be worked in
  /// value order rather than discovery order.
  amount              Decimal                       @default(0) @db.Decimal(20, 6)
  description         String
  suggestedResolution String?                       @map("suggested_resolution")
  confidence          Int?
  status              ReconciliationExceptionStatus @default(OPEN)
  resolution          String?
  resolvedById        String?                       @map("resolved_by_id")
  resolvedAt          DateTime?                     @map("resolved_at")
  createdAt           DateTime                      @default(now()) @map("created_at")
  updatedAt           DateTime                      @updatedAt @map("updated_at")

  @@index([sessionId, status])
  @@index([sessionId, severity])
  @@index([importRowId])
  @@map("reconciliation_exceptions")
}

/// A correction raised against a session. Requires a reason code, and is
/// approval-gated before it may post: an adjustment is how a reconciliation
/// difference disappears from the books, so it is not a casual edit.
model ReconciliationAdjustment {
  id                String                         @id @default(cuid())
  organizationId    String                         @map("organization_id")
  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId         String                         @map("session_id")
  session           ReconciliationSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accountId         String                         @map("account_id")
  account           Account                        @relation(fields: [accountId], references: [id])
  description       String
  debit             Decimal                        @default(0) @db.Decimal(20, 6)
  credit            Decimal                        @default(0) @db.Decimal(20, 6)
  currency          String                         @db.Char(3)
  status            ReconciliationAdjustmentStatus @default(DRAFT)
  /// Mandatory. An adjustment with no stated reason is an unexplained edit to
  /// the ledger, which is precisely what the audit trail exists to prevent.
  reasonCodeId      String                         @map("reason_code_id")
  reasonCode        ReasonCode                     @relation(fields: [reasonCodeId], references: [id])
  approvalRequestId String?                        @map("approval_request_id")
  approvalRequest   ApprovalRequest?               @relation("ReconciliationAdjustmentApproval", fields: [approvalRequestId], references: [id])
  /// The posted JournalEntry. Null until approved and posted; non-null is what
  /// proves the books actually moved.
  journalEntryId    String?                        @map("journal_entry_id")
  journalEntry      JournalEntry?                  @relation("ReconciliationAdjustmentJournalEntry", fields: [journalEntryId], references: [id])
  documentId        String?                        @map("document_id")
  postedById        String?                        @map("posted_by_id")
  postedAt          DateTime?                      @map("posted_at")
  createdById       String                         @map("created_by_id")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([sessionId, status])
  @@index([accountId])
  @@index([journalEntryId])
  @@map("reconciliation_adjustments")
}

// ============================================================================
// B5. INFRASTRUCTURE
// ============================================================================

/// All financial POST/PATCH/DELETE routes require an idempotency key so a
/// double-click, a retry or a replayed offline action cannot post twice.
model IdempotencyKey {
  id             String               @id @default(cuid())
  key            String
  scope          String
  actorId        String?              @map("actor_id")
  requestHash    String               @map("request_hash")
  status         IdempotencyKeyStatus @default(IN_PROGRESS)
  responseStatus Int?                 @map("response_status")
  responseBody   Json?                @map("response_body")
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")
  expiresAt      DateTime             @map("expires_at")

  @@unique([key, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// B6. NOTIFICATIONS   (Q1: in-app + email live in Phase 1; SMS/PUSH Phase 2)
// ============================================================================

model Notification {
  id               String               @id @default(cuid())
  organizationId   String?              @map("organization_id")
  userId           String               @map("user_id")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         NotificationCategory
  severity         NotificationSeverity @default(INFO)
  channel          NotificationChannel
  status           NotificationStatus   @default(PENDING)
  title            String
  body             String
  actionUrl        String?              @map("action_url")
  /// Set when the recipient's preference suppresses this category.
  suppressedReason String?              @map("suppressed_reason")
  dedupeKey        String?              @map("dedupe_key")
  readAt           DateTime?            @map("read_at")
  sentAt           DateTime?            @map("sent_at")
  deliveredAt      DateTime?            @map("delivered_at")
  failedAt         DateTime?            @map("failed_at")
  failureReason    String?              @map("failure_reason")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@unique([userId, channel, dedupeKey])
  @@index([userId, status, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

// ---- Document management (M12) --------------------------------------------

model Document {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  description       String?           @db.Text
  category          DocumentCategory
  status            DocumentStatus    @default(AVAILABLE)
  fileName          String            @map("file_name")
  mimeType          String            @map("mime_type")
  fileSize          Int               @map("file_size")
  checksum          String            @db.Char(64)
  storageKey        String            @map("storage_key")
  currentVersion    Int               @default(1) @map("current_version")
  metadata          Json?
  ocrStatus         DocumentOcrStatus @default(NOT_RUN) @map("ocr_status")
  ocrText           String?           @map("ocr_text") @db.Text
  ocrConfidence     Decimal?          @map("ocr_confidence") @db.Decimal(5, 4)
  expiryDate        DateTime?         @map("expiry_date") @db.Date
  renewalDueAt      DateTime?         @map("renewal_due_at") @db.Date
  renewalOfId       String?           @map("renewal_of_id")
  renewalOf         Document?         @relation("DocumentRenewals", fields: [renewalOfId], references: [id], onDelete: SetNull)
  renewals          Document[]        @relation("DocumentRenewals")
  approvalRequestId String?           @map("approval_request_id")
  uploadedById      String            @map("uploaded_by_id")
  approvedById      String?           @map("approved_by_id")
  approvedAt        DateTime?         @map("approved_at")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  versions               DocumentVersion[]
  tags                   DocumentTagLink[]
  links                  DocumentLink[]
  supportingTransactions Transaction[]        @relation("TransactionSupportingDocument")
  linkedTaxPayments      TaxPayment[]
  credentialDocuments    Credential[]
  complianceLinks        ComplianceDocument[]

  @@unique([organizationId, checksum])
  @@unique([organizationId, storageKey])
  @@index([organizationId, category, status, deletedAt])
  @@index([organizationId, expiryDate])
  @@index([organizationId, renewalDueAt])
  @@index([renewalOfId])
  @@map("documents")
}

/// A new row is created for every version. A database trigger makes these rows
/// append-only so application code cannot rewrite evidence history.
model DocumentVersion {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String       @map("document_id")
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version        Int
  fileName       String       @map("file_name")
  mimeType       String       @map("mime_type")
  fileSize       Int          @map("file_size")
  checksum       String       @db.Char(64)
  storageKey     String       @map("storage_key")
  reason         String       @db.Text
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([documentId, version])
  @@index([organizationId, documentId, createdAt])
  @@map("document_versions")
}

model DocumentTag {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdById    String            @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  deletedAt      DateTime?         @map("deleted_at")
  documents      DocumentTagLink[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@map("document_tags")
}

model DocumentTagLink {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String       @map("document_id")
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId          String       @map("tag_id")
  tag            DocumentTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([documentId, tagId])
  @@index([organizationId, tagId])
  @@map("document_tag_links")
}

/// entityType/entityId intentionally remain polymorphic: linked business
/// records span modules and are validated against the caller's organization.
model DocumentLink {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String           @map("document_id")
  document       Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType     String           @map("entity_type")
  entityId       String           @map("entity_id")
  linkType       DocumentLinkType @map("link_type")
  isPrimary      Boolean          @default(false) @map("is_primary")
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  deletedAt      DateTime?        @map("deleted_at")

  @@unique([documentId, entityType, entityId, linkType])
  @@index([organizationId, entityType, entityId, deletedAt])
  @@index([organizationId, documentId, deletedAt])
  @@map("document_links")
}

model RetentionPolicy {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  category        DocumentCategory
  retentionMonths Int              @map("retention_months")
  action          RetentionAction
  legalBasis      String           @map("legal_basis") @db.Text
  isActive        Boolean          @default(true) @map("is_active")
  createdById     String           @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, category])
  @@index([organizationId, isActive])
  @@map("retention_policies")
}

/// Generic scope supports entity-level holds as well as document-level holds.
/// approvedById is mandatory; API callers can only set themselves as approver
/// after satisfying the DOCUMENTS approval permission.
model LegalHold {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  reason         String       @db.Text
  heldById       String       @map("held_by_id")
  approvedById   String       @map("approved_by_id")
  placedAt       DateTime     @default(now()) @map("placed_at")
  releasedAt     DateTime?    @map("released_at")
  releasedById   String?      @map("released_by_id")
  releaseReason  String?      @map("release_reason") @db.Text

  @@index([organizationId, entityType, entityId, releasedAt])
  @@map("legal_holds")
}

// M13 tax and compliance records keep jurisdictional behaviour in rows, never in source code.
model TaxRule {
  id                                String              @id @default(cuid())
  organizationId                    String              @map("organization_id")
  organization                      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                              String
  name                              String
  type                              TaxRuleType
  jurisdiction                      String
  ratePercent                       Decimal?            @map("rate_percent") @db.Decimal(9, 6)
  isInclusive                       Boolean             @default(false) @map("is_inclusive")
  calculationBasis                  TaxCalculationBasis @map("calculation_basis")
  appliesWhenOrganizationRegistered Boolean             @default(true) @map("applies_when_organization_registered")
  effectiveFrom                     DateTime            @map("effective_from") @db.Date
  effectiveTo                       DateTime?           @map("effective_to") @db.Date
  isActive                          Boolean             @default(true) @map("is_active")
  payableAccountId                  String?             @map("payable_account_id")
  payableAccount                    Account?            @relation("TaxRulePayableAccount", fields: [payableAccountId], references: [id], onDelete: Restrict)
  receivableAccountId               String?             @map("receivable_account_id")
  receivableAccount                 Account?            @relation("TaxRuleReceivableAccount", fields: [receivableAccountId], references: [id], onDelete: Restrict)
  roundingMode                      TaxRoundingMode     @default(HALF_UP) @map("rounding_mode")
  minTaxableAmount                  Decimal?            @map("min_taxable_amount") @db.Decimal(20, 6)
  exemptionThreshold                Decimal?            @map("exemption_threshold") @db.Decimal(20, 6)
  verifiedByProfessionalOn          DateTime?           @map("verified_by_professional_on") @db.Date
  verifiedByProfessionalName        String?             @map("verified_by_professional_name")
  verificationReference             String?             @map("verification_reference")
  isVerified                        Boolean             @default(false) @map("is_verified")
  notes                             String?             @db.Text
  createdById                       String              @map("created_by_id")
  createdAt                         DateTime            @default(now()) @map("created_at")
  updatedAt                         DateTime            @updatedAt @map("updated_at")

  obligations TaxObligation[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, effectiveFrom, effectiveTo])
  @@map("tax_rules")
}

model TaxObligation {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRuleId      String?                @map("tax_rule_id")
  taxRule        TaxRule?               @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  period         String
  direction      TaxObligationDirection
  status         TaxObligationStatus    @default(PENDING)
  filingDueDate  DateTime?              @map("filing_due_date") @db.Date
  filedAt        DateTime?              @map("filed_at")
  taxableAmount  Decimal                @map("taxable_amount") @db.Decimal(20, 6)
  taxAmount      Decimal                @map("tax_amount") @db.Decimal(20, 6)
  currencyCode   String                 @map("currency_code") @db.Char(3)
  description    String?                @db.Text
  createdById    String                 @map("created_by_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  payments            TaxPayment[]
  complianceDocuments ComplianceDocument[]

  @@index([organizationId, status, filingDueDate])
  @@index([organizationId, taxRuleId, period])
  @@map("tax_obligations")
}

model TaxPayment {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligationId   String        @map("obligation_id")
  obligation     TaxObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  paidAt         DateTime      @map("paid_at")
  amount         Decimal       @db.Decimal(20, 6)
  currencyCode   String        @map("currency_code") @db.Char(3)
  reference      String?
  documentId     String?       @map("document_id")
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  journalEntryId String?       @unique @map("journal_entry_id")
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, obligationId, paidAt])
  @@map("tax_payments")
}

model Credential {
  id                  String           @id @default(cuid())
  organizationId      String           @map("organization_id")
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                CredentialType
  title               String
  issuingAuthority    String?          @map("issuing_authority")
  registrationNumber  String?          @map("registration_number")
  issuedDate          DateTime?        @map("issued_date") @db.Date
  expiryDate          DateTime?        @map("expiry_date") @db.Date
  responsibleUserId   String           @map("responsible_user_id")
  responsibleUser     User             @relation("CredentialResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  cost                Decimal?         @db.Decimal(20, 6)
  currencyCode        String?          @map("currency_code") @db.Char(3)
  status              CredentialStatus @default(ACTIVE)
  renewalReminderDays Int              @default(30) @map("renewal_reminder_days")
  documentId          String?          @map("document_id")
  document            Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  notes               String?          @db.Text
  createdById         String           @map("created_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  complianceDocuments ComplianceDocument[]

  @@index([organizationId, status, expiryDate])
  @@index([responsibleUserId])
  @@map("credentials")
}

model ComplianceDocument {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String         @map("document_id")
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  credentialId   String?        @map("credential_id")
  credential     Credential?    @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  obligationId   String?        @map("obligation_id")
  obligation     TaxObligation? @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  notes          String?        @db.Text
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([organizationId, documentId])
  @@index([organizationId, credentialId])
  @@index([organizationId, obligationId])
  @@map("compliance_documents")
}

/// Per-organization sequence state. Formatting is editable data and does not
/// imply that a tax invoice is valid until a configured rule has been checked.
model TaxInvoiceSequence {
  id             String       @id @default(cuid())
  organizationId String       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prefix         String       @default("")
  suffix         String       @default("")
  padding        Int          @default(0)
  nextNumber     Int          @default(1) @map("next_number")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("tax_invoice_sequences")
}
