/// Append-only. There is no update path and no delete path - enforced by
/// database triggers (prisma/migrations/*_audit_guards), not by convention.
model AuditLog {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")

  /// Total ordering across the chain.
  sequence            BigInt  @unique @default(autoincrement())
  previousHash        String? @map("previous_hash")
  /// sha256(previous_hash || sequence || actor_id || action || entity_type ||
  /// entity_id || changes || occurred_at).
  entryHash           String  @unique @map("entry_hash")
  /// HMAC-SHA256 over entry_hash with the period key (PHASE_1_PLAN.md 3.8.5).
  signature           String
  /// Which key signed this entry, so rotation stays auditable.
  signatureKeyVersion Int     @default(1) @map("signature_key_version")

  actorId        String?  @map("actor_id")
  /// Denormalised so the record survives user deletion.
  actorName      String?  @map("actor_name")
  /// Roles held at action time - survives later role changes.
  actorRoleCodes String[] @default([]) @map("actor_role_codes")

  action      AuditAction
  entityType  AuditEntityType @map("entity_type")
  entityId    String?         @map("entity_id")
  entityLabel String?         @map("entity_label")
  description String
  /// { field: { from, to } } for every mutated field.
  changes     Json?
  metadata    Json?

  ipAddress    String?      @map("ip_address")
  userAgent    String?      @map("user_agent")
  requestId    String?      @map("request_id")
  sessionId    String?      @map("session_id")
  channel      AuditChannel @default(WEB)
  result       AuditResult  @default(SUCCESS)
  errorMessage String?      @map("error_message")

  /// Event time. Client-supplied for offline sync, which is why divergence from
  /// recorded_at is itself a signal.
  occurredAt DateTime @map("occurred_at")
  /// Server write time.
  recordedAt DateTime @default(now()) @map("recorded_at")

  securityEvents SecurityEvent[]

  @@index([organizationId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
  @@index([result, occurredAt])
  @@index([requestId])
  @@map("audit_logs")
}

/// The single mutable row that anchors the hash chain. SELECT ... FOR UPDATE on
/// this row serialises concurrent audit appends, which is what makes the chain
/// gap-free: an aborted transaction rolls back the audit row and the head update
/// together, so a sequence number can never be consumed by a lost write.
model AuditChainHead {
  id        Int      @id @default(1)
  sequence  BigInt   @default(0)
  entryHash String   @default("") @map("entry_hash")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_chain_head")
}

/// Daily seals. Verification is incremental: start from the last checkpoint
/// rather than replaying the whole chain every night.
model AuditChainCheckpoint {
  id                    String                  @id @default(cuid())
  periodStart           DateTime                @map("period_start")
  periodEnd             DateTime                @map("period_end")
  sealedThroughSequence BigInt                  @map("sealed_through_sequence")
  sealedEntryHash       String                  @map("sealed_entry_hash")
  sealedAt              DateTime                @default(now()) @map("sealed_at")
  verifiedAt            DateTime?               @map("verified_at")
  status                ChainVerificationStatus @default(PENDING)
  entriesChecked        Int                     @default(0) @map("entries_checked")
  brokenAtSequence      BigInt?                 @map("broken_at_sequence")
  detail                String?

  @@index([periodEnd])
  @@index([status])
  @@map("audit_chain_checkpoints")
}

model SecurityEvent {
  id                  String                @id @default(cuid())
  organizationId      String?               @map("organization_id")
  auditLogId          String?               @map("audit_log_id")
  auditLog            AuditLog?             @relation(fields: [auditLogId], references: [id], onDelete: SetNull)
  type                SecurityEventType
  severity            SecurityEventSeverity
  /// The subject is the RECORD, not a person (PDF 65). Kept deliberately: see
  /// AnomalyFlag in M16, which has no accused-user column at all for this reason.
  subjectType         AuditEntityType?      @map("subject_type")
  subjectId           String?               @map("subject_id")
  subjectLabel        String?               @map("subject_label")
  description         String
  detail              Json?
  ipAddress           String?               @map("ip_address")
  userAgent           String?               @map("user_agent")
  requestId           String?               @map("request_id")
  /// Acknowledged by a named human before it has any effect on anything.
  acknowledgedAt      DateTime?             @map("acknowledged_at")
  acknowledgedById    String?               @map("acknowledged_by_id")
  acknowledgementNote String?               @map("acknowledgement_note")
  resolvedAt          DateTime?             @map("resolved_at")
  occurredAt          DateTime              @default(now()) @map("occurred_at")

  @@index([severity, occurredAt])
  @@index([type, occurredAt])
  @@index([acknowledgedAt])
  @@map("security_events")
}

/// Import Pipeline models (PDF §52) — M8
/// Seven-stage gated pipeline: Upload → Map Fields → Validate → Preview → Detect Duplicates → Approve → Import
enum ImportSource {
  EXCEL
  CSV
  API
  MANUAL
}

enum ImportBatchStatus {
  UPLOADED
  MAPPING
  VALIDATING
  PREVIEW
  AWAITING_APPROVAL
  APPROVED
  IMPORTING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  ROLLED_BACK
}

enum ImportErrorType {
  VALIDATION
  DUPLICATE
  MAPPING
  PERMISSION
  SYSTEM
  PARSE
}

model ImportBatch {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String // e.g., "IMP-2025-001"
  source         ImportSource
  fileName       String            @map("file_name")
  fileHash       String            @map("file_hash") // SHA256 for duplicate detection
  fileSize       Int               @map("file_size")
  mimeType       String            @map("mime_type")
  status         ImportBatchStatus @default(UPLOADED)
  totalRows      Int               @default(0) @map("total_rows")
  validRows      Int               @default(0) @map("valid_rows")
  errorRows      Int               @default(0) @map("error_rows")
  duplicateRows  Int               @default(0) @map("duplicate_rows")
  uploadedById   String            @map("uploaded_by_id")
  uploadedBy     User              @relation("ImportBatchUploadedBy", fields: [uploadedById], references: [id])
  mappedById     String?           @map("mapped_by_id")
  mappedBy       User?             @relation("ImportBatchMappedBy", fields: [mappedById], references: [id])
  validatedById  String?           @map("validated_by_id")
  validatedBy    User?             @relation("ImportBatchValidatedBy", fields: [validatedById], references: [id])
  approvedById   String?           @map("approved_by_id")
  approvedBy     User?             @relation("ImportBatchApprovedBy", fields: [approvedById], references: [id])
  importedById   String?           @map("imported_by_id")
  importedBy     User?             @relation("ImportBatchImportedBy", fields: [importedById], references: [id])
  rolledBackById String?           @map("rolled_back_by_id")
  rolledBackBy   User?             @relation("ImportBatchRolledBackBy", fields: [rolledBackById], references: [id])
  approvedAt     DateTime?         @map("approved_at")
  importedAt     DateTime?         @map("imported_at")
  rolledBackAt   DateTime?         @map("rolled_back_at")
  errorSummary   Json?             @map("error_summary")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  rows          ImportRow[]
  fieldMappings ImportFieldMapping[]
  errors        ImportError[]

  @@unique([organizationId, code])
  @@unique([organizationId, fileHash])
  @@index([status])
  @@index([uploadedById])
  @@map("import_batches")
}

model ImportRow {
  id                    String      @id @default(cuid())
  batchId               String      @map("batch_id")
  batch                 ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber             Int         @map("row_number")
  rawData               Json        @map("raw_data") // Original row data verbatim
  mappedData            Json?       @map("mapped_data") // After field mapping
  normalizedData        Json?       @map("normalized_data") // After normalization (dates, amounts)
  status                String      @default("PENDING") // PENDING, VALID, ERROR, DUPLICATE, SKIPPED
  fingerprint           String? // Normalized hash for duplicate detection
  importedTransactionId String?     @map("imported_transaction_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  errors ImportError[]

  @@index([batchId, status])
  @@index([batchId, fingerprint])
  @@map("import_rows")
}

model ImportFieldMapping {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId           String?      @map("batch_id") // Null = global default for source
  batch             ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  source            ImportSource
  name              String // e.g., "CRDB Bank TZS CSV"
  description       String?
  dateFormat        String       @map("date_format") // e.g., "yyyy-MM-dd", "dd/MM/yyyy"
  amountConvention  String       @map("amount_convention") // SINGLE_DEBIT_CREDIT | SEPARATE_DEBIT_CREDIT | SIGNED_SINGLE
  decimalSeparator  String       @default(".") @map("decimal_separator")
  thousandSeparator String       @default(",") @map("thousand_separator")
  encoding          String       @default("UTF-8")
  hasHeader         Boolean      @default(true) @map("has_header")
  columnMap         Json         @map("column_map") // { date: 0, description: 1, debit: 2, credit: 3, reference: 4 }
  isDefault         Boolean      @default(false) @map("is_default")
  createdById       String       @map("created_by_id")
  createdBy         User         @relation("ImportFieldMappingCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, source, name])
  @@index([organizationId, source, isDefault])
  @@map("import_field_mappings")
}

model ImportError {
  id             String          @id @default(cuid())
  batchId        String          @map("batch_id")
  batch          ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowId          String?         @map("row_id")
  row            ImportRow?      @relation(fields: [rowId], references: [id], onDelete: SetNull)
  rowNumber      Int             @map("row_number")
  type           ImportErrorType
  field          String? // Which column/field failed
  originalValue  Json?           @map("original_value") // The raw value that failed
  message        String
  severity       String          @default("ERROR") // ERROR | WARNING
  resolved       Boolean         @default(false)
  resolvedById   String?         @map("resolved_by_id")
  resolvedBy     User?           @relation("ImportErrorResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?       @map("resolved_at")
  resolutionNote String?         @map("resolution_note")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([batchId, resolved])
  @@index([batchId, rowNumber])
  @@map("import_errors")
}

// ============================================================================
// B5. INFRASTRUCTURE
// ============================================================================

/// All financial POST/PATCH/DELETE routes require an idempotency key so a
/// double-click, a retry or a replayed offline action cannot post twice.
model IdempotencyKey {
  id             String               @id @default(cuid())
  key            String
  scope          String
  actorId        String?              @map("actor_id")
  requestHash    String               @map("request_hash")
  status         IdempotencyKeyStatus @default(IN_PROGRESS)
  responseStatus Int?                 @map("response_status")
  responseBody   Json?                @map("response_body")
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")
  expiresAt      DateTime             @map("expires_at")

  @@unique([key, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// B6. NOTIFICATIONS   (Q1: in-app + email live in Phase 1; SMS/PUSH Phase 2)
// ============================================================================

model Notification {
  id               String               @id @default(cuid())
  organizationId   String?              @map("organization_id")
  userId           String               @map("user_id")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         NotificationCategory
  severity         NotificationSeverity @default(INFO)
  channel          NotificationChannel
  status           NotificationStatus   @default(PENDING)
  title            String
  body             String
  actionUrl        String?              @map("action_url")
  /// Set when the recipient's preference suppresses this category.
  suppressedReason String?              @map("suppressed_reason")
  dedupeKey        String?              @map("dedupe_key")
  readAt           DateTime?            @map("read_at")
  sentAt           DateTime?            @map("sent_at")
  deliveredAt      DateTime?            @map("delivered_at")
  failedAt         DateTime?            @map("failed_at")
  failureReason    String?              @map("failure_reason")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@unique([userId, channel, dedupeKey])
  @@index([userId, status, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}
