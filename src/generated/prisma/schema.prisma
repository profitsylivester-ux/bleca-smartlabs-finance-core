  INVOICE
  PAYMENT
  RECEIPT
  QUOTATION
  CREDIT_NOTE
  DEBIT_NOTE
  REFUND
  BUDGET
  BUDGET_REVISION
  BUDGET_TRANSFER
  COMMITMENT
  PERIOD_REOPEN
  FINANCIAL_CLOSE
  ADJUSTMENT
  REVERSAL
  MASTER_DATA_CHANGE
  SUPPLIER_BANK_DETAIL_CHANGE
  CUSTOMER_CREDIT_LIMIT
  DOCUMENT
  IMPORT_BATCH
  RECONCILIATION
  RECONCILIATION_ADJUSTMENT
  TAX_FILING
}

enum ApprovalRequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  SUPERSEDED
}

enum ApprovalStepType {
  APPROVAL
  REVIEW
  NOTIFICATION
  SIGN_OFF
}

enum ApprovalAssigneeType {
  ROLE
  USER
  USER_DELEGATED
  SPECIFIC_USER
}

enum ApprovalOutcome {
  PENDING
  APPROVED
  REJECTED
}

enum ResolutionMode {
  ANY
  ALL
  QUORUM
}

enum ApprovalConditionOperator {
  ALWAYS
  AMOUNT_GREATER_THAN
  AMOUNT_GREATER_OR_EQUAL
  AMOUNT_LESS_THAN
  AMOUNT_BETWEEN
  PERCENT_OF_BUDGET
  OVER_BUDGET
  NEW_COUNTERPARTY
  SUPPLIER_BANK_DETAIL_CHANGED
  FUNDING_RESTRICTED
  CROSS_PROJECT
  CURRENCY_NOT_BASE
  MANUAL_FLAG
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  DEFERRED
  RETURNED_FOR_CHANGES
  SKIPPED
  CANCELLED
}

/// Approval Workflow enums (M6) --------------------------------------------------
enum SODWaiverStatus {
  PENDING
  GRANTED
  REJECTED
  EXPIRED
}

// ============================================================================
// B1. IDENTITY, ACCESS & AUTHENTICATION   (PDF 4, PDF 5)
// ============================================================================

model User {
  id              String  @id @default(cuid())
  email           String
  emailNormalized String  @unique @map("email_normalized")
  fullName        String  @map("full_name")
  jobTitle        String? @map("job_title")
  phone           String?
  avatarUrl       String? @map("avatar_url")

  status             UserStatus @default(INVITED)
  isActive           Boolean    @default(true)
  deactivatedAt      DateTime?  @map("deactivated_at")
  deactivationReason String?    @map("deactivation_reason")

  // --- Credentials -----------------------------------------------------------
  passwordHash           String?                @map("password_hash")
  passwordAlgorithm      PasswordHashAlgorithm? @map("password_algorithm")
  passwordChangedAt      DateTime?              @map("password_changed_at")
  mustChangePassword     Boolean                @default(false) @map("must_change_password")
  failedLoginCount       Int                    @default(0) @map("failed_login_count")
  lockedUntil            DateTime?              @map("locked_until")
  lastLoginAt            DateTime?              @map("last_login_at")
  emailVerifiedAt        DateTime?              @map("email_verified_at")
  passwordResetToken     String?                @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime?              @map("password_reset_expires_at")

  /// Prior password hashes, retained so "do not reuse" can be enforced later
  /// without losing history.
  passwordHistory String[] @default([]) @map("password_history")

  // --- MFA (PDF 4) -----------------------------------------------------------
  /// Enforced for CEO and Finance Officer by default (BUILD_PROMPT 7). Seeded
  /// from the ROLE, never from a client-supplied flag.
  mfaEnforced   Boolean   @default(false) @map("mfa_enforced")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  // --- Organisation context --------------------------------------------------
  primaryLocationId String?     @map("primary_location_id")
  primaryLocation   Location?   @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id])
  homeDepartmentId  String?     @map("home_department_id")
  homeDepartment    Department? @relation("UserHomeDepartment", fields: [homeDepartmentId], references: [id])

  /// PDF 56: classification for data-protection handling. Not a legal claim.
  dataClassification String    @default("INTERNAL") @map("data_classification")
  retentionReviewAt  DateTime? @map("retention_review_at")

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organizationMemberships          OrganizationMembership[]
  sessions                         Session[]
  loginHistory                     LoginHistory[]
  mfaDevices                       MfaDevice[]
  userRoles                        UserRole[]
  delegationsGranted               Delegation[]              @relation("DelegationGrantor")
  delegationsReceived              Delegation[]              @relation("DelegationGrantee")
  accessReviewItems                AccessReviewItem[]
  notifications                    Notification[]
  responsibleCredentials           Credential[]              @relation("CredentialResponsibleUser")
  notificationPreferences          NotificationPreference[]
  createdUsers                     User[]                    @relation("UserCreatedBy")
  updatedUsers                     User[]                    @relation("UserUpdatedBy")
  changeRequestsRequested          MasterDataChangeRequest[] @relation("ChangeRequestRequestedBy")
  changeRequestsApproved           MasterDataChangeRequest[] @relation("ChangeRequestApprovedBy")
  journalEntriesSubmitted          JournalEntry[]            @relation("JournalEntrySubmittedBy")
  journalEntriesApproved           JournalEntry[]            @relation("JournalEntryApprovedBy")
  journalEntriesPosted             JournalEntry[]            @relation("JournalEntryPostedBy")
  journalEntriesReversed           JournalEntry[]            @relation("JournalEntryReversedBy")
  transactionsCreated              Transaction[]             @relation("TransactionCreatedBy")
  transactionsSubmitted            Transaction[]             @relation("TransactionSubmittedBy")
  transactionsApproved             Transaction[]             @relation("TransactionApprovedBy")
  transactionsPosted               Transaction[]             @relation("TransactionPostedBy")
  transactionsReversed             Transaction[]             @relation("TransactionReversedBy")
  approvalRequestsSubmitted        ApprovalRequest[]         @relation("ApprovalRequestSubmittedBy")
  approvalRequestsDecided          ApprovalRequest[]         @relation("ApprovalRequestDecidedBy")
  approvalStepInstancesDecided     ApprovalStepInstance[]    @relation("ApprovalStepInstanceDecidedBy")
  approvalDecisionRecords          ApprovalDecisionRecord[]  @relation("ApprovalDecisionRecordActor")
  approvalPolicyStepAssigneeUser   ApprovalPolicyStep[]      @relation("ApprovalPolicyStepAssigneeUser")
  approvalStepInstanceAssigneeUser ApprovalStepInstance[]    @relation("ApprovalStepInstanceAssigneeUser")
  sodWaiversAsUser                 SODWaiver[]               @relation("SODWaiverUser")
  sodWaiversRecordedBy             SODWaiver[]               @relation("SODWaiverRecordedBy")
  sodWaiversReviewedBy             SODWaiver[]               @relation("SODWaiverReviewedBy")
  transfersSubmitted               Transfer[]                @relation("TransferSubmittedBy")
  transfersApproved                Transfer[]                @relation("TransferApprovedBy")
  transfersProcessed               Transfer[]                @relation("TransferProcessedBy")
  transfersReversed                Transfer[]                @relation("TransferReversedBy")
  importBatchesUploaded            ImportBatch[]             @relation("ImportBatchUploadedBy")
  importBatchesMapped              ImportBatch[]             @relation("ImportBatchMappedBy")
  importBatchesValidated           ImportBatch[]             @relation("ImportBatchValidatedBy")
  importBatchesApproved            ImportBatch[]             @relation("ImportBatchApprovedBy")
  importBatchesImported            ImportBatch[]             @relation("ImportBatchImportedBy")
  importBatchesRolledBack          ImportBatch[]             @relation("ImportBatchRolledBackBy")
  importFieldMappingsCreated       ImportFieldMapping[]      @relation("ImportFieldMappingCreatedBy")
  importErrorsResolved             ImportError[]             @relation("ImportErrorResolvedBy")

  budgetsCreated          Budget[]         @relation("BudgetCreatedBy")
  budgetsApproved         Budget[]         @relation("BudgetApprovedBy")
  commitmentsCreated      Commitment[]     @relation("CommitmentCreatedBy")
  budgetRevisionsCreated  BudgetRevision[] @relation("BudgetRevisionCreatedBy")
  budgetRevisionsApproved BudgetRevision[] @relation("BudgetRevisionApprovedBy")
  budgetTransfersCreated  BudgetTransfer[] @relation("BudgetTransferCreatedBy")
  budgetTransfersApproved BudgetTransfer[] @relation("BudgetTransferApprovedBy")
  budgetScenariosCreated  BudgetScenario[] @relation("BudgetScenarioCreatedBy")

  @@index([status, isActive])
  @@index([primaryLocationId])
  @@index([homeDepartmentId])
  @@index([deletedAt])
  @@map("users")
}

model MfaDevice {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  method           MfaMethod       @default(TOTP)
  label            String
  /// AES-256-GCM ciphertext. A plaintext TOTP secret must never reach the table.
  secretEnc        String          @map("secret_enc")
  recoveryCodesEnc String?         @map("recovery_codes_enc")
  status           MfaDeviceStatus @default(PENDING)
  confirmedAt      DateTime?       @map("confirmed_at")
  lastUsedAt       DateTime?       @map("last_used_at")
  /// Replay protection: the last accepted counter. A TOTP code may not be reused.
  lastUsedCounter  Int             @default(-1) @map("last_used_counter")
  failedAttempts   Int             @default(0) @map("failed_attempts")
  lockedUntil      DateTime?       @map("locked_until")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("mfa_devices")
}

model Session {
  id                String               @id @default(cuid())
  /// Referenced by the `sid` claim in the Auth.js JWT. Rotated on privilege change.
  sessionToken      String               @unique @map("session_token")
  userId            String               @map("user_id")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress         String?              @map("ip_address")
  userAgent         String?              @map("user_agent")
  deviceFingerprint String?              @map("device_fingerprint")
  deviceLabel       String?              @map("device_label")
  createdAt         DateTime             @default(now()) @map("created_at")
  lastActiveAt      DateTime             @default(now()) @map("last_active_at")
  /// Both timeouts are resolved from AuthPolicy at issue time and then enforced
  /// against these absolute instants, so a later policy change cannot silently
  /// extend a session that is already live.
  idleTimeoutAt     DateTime?            @map("idle_timeout_at")
  absoluteExpiresAt DateTime             @map("absolute_expires_at")
  revokedAt         DateTime?            @map("revoked_at")
  revokedReason     SessionRevokeReason? @map("revoked_reason")
  mfaSatisfiedAt    DateTime?            @map("mfa_satisfied_at")
  /// Step-up authentication: set when the actor re-authenticated for a sensitive
  /// action. Cleared once consumed.
  stepUpSatisfiedAt DateTime?            @map("step_up_satisfied_at")
  stepUpExpiresAt   DateTime?            @map("step_up_expires_at")

  @@index([userId, lastActiveAt])
  @@index([deviceFingerprint])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model LoginHistory {
  id                String       @id @default(cuid())
  userId            String?      @map("user_id")
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailAttempted    String       @map("email_attempted")
  outcome           LoginOutcome
  ipAddress         String?      @map("ip_address")
  userAgent         String?      @map("user_agent")
  deviceFingerprint String?      @map("device_fingerprint")
  mfaAttempted      Boolean      @default(false) @map("mfa_attempted")
  failureReason     String?      @map("failure_reason")
  sessionId         String?      @map("session_id")
  occurredAt        DateTime     @default(now()) @map("occurred_at")

  @@index([userId, occurredAt])
  @@index([emailAttempted, occurredAt])
  @@index([outcome, occurredAt])
  @@map("login_history")
}

/// Lockout, rate limiting, password strength and session timeouts are CONFIG,
/// not code (PDF 4). Changing one is an audited CONFIGURATION_CHANGES event.
model AuthPolicy {
  id       String @id @default(cuid())
  name     String @unique
  priority Int    @default(100)

  maxFailedAttempts      Int @default(5) @map("max_failed_attempts")
  lockoutDurationMinutes Int @default(15) @map("lockout_duration_minutes")
  rateLimitWindowSeconds Int @default(60) @map("rate_limit_window_seconds")
  maxAttemptsPerWindow   Int @default(10) @map("max_attempts_per_window")
  ipRateLimitPerMinute   Int @default(20) @map("ip_rate_limit_per_minute")

  sessionIdleTimeoutMinutes   Int @default(30) @map("session_idle_timeout_minutes")
  sessionAbsoluteTimeoutHours Int @default(12) @map("session_absolute_timeout_hours")

  passwordMinLength        Int     @default(12) @map("password_min_length")
  passwordRequireUppercase Boolean @default(true) @map("password_require_uppercase")
  passwordRequireLowercase Boolean @default(true) @map("password_require_lowercase")
  passwordRequireNumber    Boolean @default(true) @map("password_require_number")
  passwordRequireSymbol    Boolean @default(true) @map("password_require_symbol")

  /// Role codes that must hold MFA. Seeded with CEO and FINANCE_OFFICER.
  mfaRequiredRoleCodes       String[] @default([]) @map("mfa_required_role_codes")
  /// Lifetime of the pre-MFA challenge session.
  mfaChallengeTimeoutMinutes Int      @default(10) @map("mfa_challenge_timeout_minutes")
  /// Lifetime of a step-up authentication grant.
  stepUpTimeoutMinutes       Int      @default(5) @map("step_up_timeout_minutes")

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@index([isActive, priority])
  @@map("auth_policies")
}

// ============================================================================
// B2. RBAC   (PDF 5)
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  type        RoleType @default(STANDARD)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)

  /// CEO final authority (PDF 3.1).
  isFinalApprover   Boolean @default(false) @map("is_final_approver")
  /// ALWAYS false in Phase 1. No role can bypass approval; the CEO path is a
  /// recorded per-item waiver, not a standing bypass (Q3).
  canBypassApproval Boolean @default(false) @map("can_bypass_approval")

  /// Q2: every amount requires CEO approval in Phase 1. These columns exist for
  /// the future configuration path and are NOT seeded with a band.
  maxApprovalAmount Decimal? @map("max_approval_amount") @db.Decimal(20, 6)
  approvalCurrency  String?  @map("approval_currency") @db.Char(3)

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions                  RolePermission[]
  scopeGrants                      RoleScopeGrant[]
  userRoles                        UserRole[]
  delegations                      Delegation[]
  accessReviewItems                AccessReviewItem[]
  approvalPolicySteps              ApprovalPolicyStep[]   @relation("ApprovalPolicyStepAssigneeRole")
  approvalStepInstanceAssigneeRole ApprovalStepInstance[] @relation("ApprovalStepInstanceAssigneeRole")

  @@index([isSystem, isActive])
  @@map("roles")
}

model Permission {
  id                 String           @id @default(cuid())
  module             ModuleKey
  action             PermissionAction
  /// Optional sub-resource, e.g. "supplier.bank_details".
  resource           String?
  description        String?
  /// PDF 5: sensitive actions take additional authorization. Set on supplier bank
  /// details, permission changes, period reopen and high-value exports.
  requiresStepUpAuth Boolean          @default(false) @map("requires_step_up_auth")

  roles       RolePermission[]
  scopeGrants RoleScopeGrant[]

  @@unique([module, action, resource])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  /// Extra constraints attached to this specific grant.
  conditions   Json?

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// PDF 4: temporary access. `expiresAt` is mandatory whenever isTemporary.
  isTemporary Boolean   @default(false) @map("is_temporary")
  startsAt    DateTime  @default(now()) @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  grantedById String?   @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  reason      String?

  @@index([userId, revokedAt])
  @@index([roleId])
  @@index([expiresAt])
  @@map("user_roles")
}

/// Dimension-scoped grants (PDF 5). dimension_value_id = NULL means "all values".
/// DENY always wins over ALLOW (resolution order in lib/rbac/scope.ts).
model RoleScopeGrant {
  id               String         @id @default(cuid())
  roleId           String         @map("role_id")
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId     String?        @map("permission_id")
  permission       Permission?    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  dimension        ScopeDimension
  dimensionValueId String?        @map("dimension_value_id")
  includeChildren  Boolean        @default(false) @map("include_children")
  effect           String         @default("ALLOW")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roleId, dimension])
  @@index([dimension, dimensionValueId])
  @@map("role_scope_grants")
}

/// PDF 4: delegated authority. `expiresAt` is MANDATORY and validated in code -
/// an open-ended delegation is rejected, not merely discouraged.
model Delegation {
  id        String @id @default(cuid())
  grantorId String @map("grantor_id")
  grantor   User   @relation("DelegationGrantor", fields: [grantorId], references: [id], onDelete: Cascade)
  granteeId String @map("grantee_id")
  grantee   User   @relation("DelegationGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  kind             DelegationKind
  roleId           String?        @map("role_id")
  role             Role?          @relation(fields: [roleId], references: [id])
  /// Dimension limits, amount ceilings, entity limits.
  scope            Json?
  reason           String
  startsAt         DateTime       @map("starts_at")
  /// Mandatory. Enforced in the service layer and by the "no unbounded
  /// delegation" test.
  expiresAt        DateTime       @map("expires_at")
  revokedAt        DateTime?      @map("revoked_at")
  revokedById      String?        @map("revoked_by_id")
  revocationReason String?        @map("revocation_reason")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([granteeId, expiresAt])
  @@index([grantorId])
  @@index([roleId])
  @@map("delegations")
}

model AccessReview {
  id            String             @id @default(cuid())
  name          String
  periodStart   DateTime           @map("period_start")
  periodEnd     DateTime           @map("period_end")
  status        AccessReviewStatus @default(OPEN)
  scopeJson     Json?              @map("scope_json")
  initiatedById String             @map("initiated_by_id")
  completedAt   DateTime?          @map("completed_at")
  summary       String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items AccessReviewItem[]

  @@index([status])
  @@map("access_reviews")
}

model AccessReviewItem {
  id               String       @id @default(cuid())
  reviewId         String       @map("review_id")
  review           AccessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId           String       @map("user_id")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Held by plain id, deliberately: a review must show what was granted at the
  /// time it was opened, so it reads the role as it is now but never joins to a
  /// live user_role row.
  roleId           String       @map("role_id")
  role             Role         @relation(fields: [roleId], references: [id])
  currentExpiresAt DateTime?    @map("current_expires_at")
  decision         String?
  decisionReason   String?      @map("decision_reason")
  decidedById      String?      @map("decided_by_id")
  decidedAt        DateTime?    @map("decided_at")
  actionedAt       DateTime?    @map("actioned_at")

  @@unique([reviewId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("access_review_items")
}

/// Approval Workflow models (M6) -------------------------------------------------
model ApprovalPolicy {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  entityType     ApprovalEntityType
  isActive       Boolean            @default(true)
  priority       Int                @default(100)
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedById    String?            @map("updated_by_id")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  steps    ApprovalPolicyStep[] @relation("ApprovalPolicySteps")
  requests ApprovalRequest[]    @relation("ApprovalRequestPolicy")

  @@index([organizationId, entityType, isActive])
  @@map("approval_policies")
}

model ApprovalPolicyStep {
  id                String                     @id @default(cuid())
  policyId          String                     @map("policy_id")
  policy            ApprovalPolicy             @relation("ApprovalPolicySteps", fields: [policyId], references: [id], onDelete: Cascade)
  stepOrder         Int                        @map("step_order")
  name              String
  type              ApprovalStepType
  assigneeType      ApprovalAssigneeType       @map("assignee_type")
  assigneeRoleId    String?                    @map("assignee_role_id")
  assigneeRole      Role?                      @relation("ApprovalPolicyStepAssigneeRole", fields: [assigneeRoleId], references: [id])
  assigneeUserId    String?                    @map("assignee_user_id")
  assigneeUser      User?                      @relation("ApprovalPolicyStepAssigneeUser", fields: [assigneeUserId], references: [id])
  resolutionMode    ResolutionMode             @default(ANY) @map("resolution_mode")
  quorum            Int? // used when resolutionMode = QUORUM
  conditionOperator ApprovalConditionOperator? @map("condition_operator")
  conditionValue    Json?                      @map("condition_value")
  isRequired        Boolean                    @default(true) @map("is_required")
  isFinalApprover   Boolean                    @default(false) @map("is_final_approver")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@unique([policyId, stepOrder])
  @@index([policyId])
  @@map("approval_policy_steps")
}

model ApprovalRequest {
  id               String                @id @default(cuid())
  organizationId   String                @map("organization_id")
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType       ApprovalEntityType    @map("entity_type")
  entityId         String                @map("entity_id")
  policyId         String                @map("policy_id")
  policy           ApprovalPolicy        @relation("ApprovalRequestPolicy", fields: [policyId], references: [id])
  policySnapshot   Json                  @map("policy_snapshot")
  status           ApprovalRequestStatus @default(PENDING)
  submittedById    String                @map("submitted_by_id")
  submittedBy      User                  @relation("ApprovalRequestSubmittedBy", fields: [submittedById], references: [id])
  submittedAt      DateTime              @default(now()) @map("submitted_at")
  currentStepIndex Int                   @default(0) @map("current_step_index")
  decidedAt        DateTime?             @map("decided_at")
  decidedById      String?               @map("decided_by_id")
  decidedBy        User?                 @relation("ApprovalRequestDecidedBy", fields: [decidedById], references: [id])
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  stepInstances             ApprovalStepInstance[]     @relation("ApprovalRequestStepInstances")
  decisionRecords           ApprovalDecisionRecord[]   @relation("ApprovalRequestDecisionRecords")
  sodWaivers                SODWaiver[]
  reconciliationAdjustments ReconciliationAdjustment[] @relation("ReconciliationAdjustmentApproval")

  @@index([organizationId, entityType, entityId])
  @@index([status])
  @@index([submittedById])
  @@map("approval_requests")
}

model ApprovalStepInstance {
  id             String                @id @default(cuid())
  requestId      String                @map("request_id")
  request        ApprovalRequest       @relation("ApprovalRequestStepInstances", fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder      Int                   @map("step_order")
  stepName       String                @map("step_name")
  stepType       ApprovalStepType      @map("step_type")
  assigneeType   ApprovalAssigneeType  @map("assignee_type")
  assigneeRoleId String?               @map("assignee_role_id")
  assigneeRole   Role?                 @relation("ApprovalStepInstanceAssigneeRole", fields: [assigneeRoleId], references: [id])
  assigneeUserId String?               @map("assignee_user_id")
  assigneeUser   User?                 @relation("ApprovalStepInstanceAssigneeUser", fields: [assigneeUserId], references: [id])
  resolutionMode ResolutionMode        @map("resolution_mode")
  quorum         Int?
  status         ApprovalRequestStatus @default(PENDING)
  decidedAt      DateTime?             @map("decided_at")
  decidedById    String?               @map("decided_by_id")
  decidedBy      User?                 @relation("ApprovalStepInstanceDecidedBy", fields: [decidedById], references: [id])
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  decisions ApprovalDecisionRecord[] @relation("ApprovalStepInstanceDecisions")

  @@unique([requestId, stepOrder])
  @@index([requestId])
  @@index([assigneeUserId, status])
  @@index([assigneeRoleId, status])
  @@map("approval_step_instances")
}

model ApprovalDecisionRecord {
  id             String               @id @default(cuid())
  requestId      String               @map("request_id")
  request        ApprovalRequest      @relation("ApprovalRequestDecisionRecords", fields: [requestId], references: [id], onDelete: Cascade)
