  paymentTermsDays    Int              @default(30) @map("payment_terms_days")
  paymentCurrencyCode String?          @map("payment_currency_code") @db.Char(3)
  performanceRating   Decimal?         @map("performance_rating") @db.Decimal(4, 2)
  deliveryRating      Decimal?         @map("delivery_rating") @db.Decimal(4, 2)
  qualityRating       Decimal?         @map("quality_rating") @db.Decimal(4, 2)
  riskLevel           PartyRiskLevel   @default(MEDIUM) @map("risk_level")
  createdById         String?          @map("created_by_id")
  updatedById         String?          @map("updated_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  bankDetails              SupplierBankDetail[]
  bankDetailChangeRequests SupplierBankDetailChangeRequest[]
  productsServices         SupplierProductService[]
  taxObligations           SupplierTaxObligationLink[]
  invoices                 Invoice[]
  payments                 Payment[]

  @@index([organizationId, status, masterDataStatus])
  @@map("suppliers")
}

