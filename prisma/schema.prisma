// ============================================================================
// B1. IDENTITY, ACCESS & AUTHENTICATION   (PDF 4, PDF 5)
// ============================================================================

model User {
  id              String     @id @default(cuid())
  email           String
  emailNormalized String     @unique @map("email_normalized")
  fullName        String     @map("full_name")
  jobTitle        String?    @map("job_title")
  phone           String?
  avatarUrl       String?    @map("avatar_url")

  status    UserStatus @default(INVITED)
  isActive  Boolean    @default(true)
  deactivatedAt      DateTime? @map("deactivated_at")
  deactivationReason String?   @map("deactivation_reason")

  // --- Credentials -----------------------------------------------------------
  passwordHash           String?               @map("password_hash")
  passwordAlgorithm      PasswordHashAlgorithm? @map("password_algorithm")
  passwordChangedAt      DateTime?             @map("password_changed_at")
  mustChangePassword     Boolean               @default(false) @map("must_change_password")
  failedLoginCount       Int                   @default(0) @map("failed_login_count")
  lockedUntil            DateTime?             @map("locked_until")
  lastLoginAt            DateTime?             @map("last_login_at")
  emailVerifiedAt        DateTime?             @map("email_verified_at")
  passwordResetToken     String?               @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime?             @map("password_reset_expires_at")

  /// Prior password hashes, retained so "do not reuse" can be enforced later
  /// without losing history.
  passwordHistory String[] @default([]) @map("password_history")

  // --- MFA (PDF 4) -----------------------------------------------------------
  /// Enforced for CEO and Finance Officer by default (BUILD_PROMPT 7). Seeded
  /// from the ROLE, never from a client-supplied flag.
  mfaEnforced   Boolean   @default(false) @map("mfa_enforced")
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  // --- Organisation context --------------------------------------------------
  primaryLocationId String? @map("primary_location_id")
  primaryLocation   Location? @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id])
  homeDepartmentId  String? @map("home_department_id")
  homeDepartment    Department? @relation("UserHomeDepartment", fields: [homeDepartmentId], references: [id])

  /// PDF 56: classification for data-protection handling. Not a legal claim.
  dataClassification String    @default("INTERNAL") @map("data_classification")
  retentionReviewAt  DateTime? @map("retention_review_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organizationMemberships OrganizationMembership[]
  sessions                Session[]
  loginHistory            LoginHistory[]
  mfaDevices              MfaDevice[]
  userRoles               UserRole[]
  delegationsGranted      Delegation[]            @relation("DelegationGrantor")
  delegationsReceived     Delegation[]            @relation("DelegationGrantee")
  accessReviewItems       AccessReviewItem[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  createdUsers            User[]                  @relation("UserCreatedBy")
  updatedUsers            User[]                  @relation("UserUpdatedBy")
  changeRequestsRequested MasterDataChangeRequest[] @relation("ChangeRequestRequestedBy")
  changeRequestsApproved  MasterDataChangeRequest[] @relation("ChangeRequestApprovedBy")
  journalEntriesSubmitted JournalEntry[] @relation("JournalEntrySubmittedBy")
  journalEntriesApproved  JournalEntry[] @relation("JournalEntryApprovedBy")
  journalEntriesPosted    JournalEntry[] @relation("JournalEntryPostedBy")
  journalEntriesReversed  JournalEntry[] @relation("JournalEntryReversedBy")

  @@index([status, isActive])
  @@index([primaryLocationId])
  @@index([homeDepartmentId])
  @@index([deletedAt])
  @@map("users")
}

model MfaDevice {
  id     String    @id @default(cuid())
  userId String    @map("user_id")
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method MfaMethod @default(TOTP)
  label  String
  /// AES-256-GCM ciphertext. A plaintext TOTP secret must never reach the table.
  secretEnc String @map("secret_enc")
  recoveryCodesEnc String? @map("recovery_codes_enc")
  status MfaDeviceStatus @default(PENDING)
  confirmedAt DateTime? @map("confirmed_at")
  lastUsedAt   DateTime? @map("last_used_at")
  /// Replay protection: the last accepted counter. A TOTP code may not be reused.
  lastUsedCounter Int       @default(-1) @map("last_used_counter")
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("mfa_devices")
}

model Session {
  id           String  @id @default(cuid())
  /// Referenced by the `sid` claim in the Auth.js JWT. Rotated on privilege change.
  sessionToken String  @unique @map("session_token")
  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress         String? @map("ip_address")
  userAgent         String? @map("user_agent")
  deviceFingerprint String? @map("device_fingerprint")
  deviceLabel       String? @map("device_label")
  createdAt         DateTime @default(now()) @map("created_at")
  lastActiveAt      DateTime @default(now()) @map("last_active_at")
  /// Both timeouts are resolved from AuthPolicy at issue time and then enforced
  /// against these absolute instants, so a later policy change cannot silently
  /// extend a session that is already live.
  idleTimeoutAt     DateTime? @map("idle_timeout_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     SessionRevokeReason? @map("revoked_reason")
  mfaSatisfiedAt    DateTime? @map("mfa_satisfied_at")
  /// Step-up authentication: set when the actor re-authenticated for a sensitive
  /// action. Cleared once consumed.
  stepUpSatisfiedAt DateTime? @map("step_up_satisfied_at")
  stepUpExpiresAt   DateTime? @map("step_up_expires_at")

  @@index([userId, lastActiveAt])
  @@index([deviceFingerprint])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model LoginHistory {
  id                String       @id @default(cuid())
  userId            String?      @map("user_id")
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailAttempted    String       @map("email_attempted")
  outcome           LoginOutcome
  ipAddress         String?      @map("ip_address")
  userAgent         String?      @map("user_agent")
  deviceFingerprint String?      @map("device_fingerprint")
  mfaAttempted      Boolean      @default(false) @map("mfa_attempted")
  failureReason     String?      @map("failure_reason")
  sessionId         String?      @map("session_id")
  occurredAt        DateTime     @default(now()) @map("occurred_at")

  @@index([userId, occurredAt])
  @@index([emailAttempted, occurredAt])
  @@index([outcome, occurredAt])
  @@map("login_history")
}

/// Lockout, rate limiting, password strength and session timeouts are CONFIG,
/// not code (PDF 4). Changing one is an audited CONFIGURATION_CHANGES event.
model AuthPolicy {
  id       String @id @default(cuid())
  name     String @unique
  priority Int    @default(100)

  maxFailedAttempts       Int @default(5) @map("max_failed_attempts")
  lockoutDurationMinutes  Int @default(15) @map("lockout_duration_minutes")
  rateLimitWindowSeconds  Int @default(60) @map("rate_limit_window_seconds")
  maxAttemptsPerWindow     Int @default(10) @map("max_attempts_per_window")
  ipRateLimitPerMinute     Int @default(20) @map("ip_rate_limit_per_minute")

  sessionIdleTimeoutMinutes   Int @default(30) @map("session_idle_timeout_minutes")
  sessionAbsoluteTimeoutHours Int @default(12) @map("session_absolute_timeout_hours")

  passwordMinLength        Int     @default(12) @map("password_min_length")
  passwordRequireUppercase Boolean @default(true) @map("password_require_uppercase")
  passwordRequireLowercase Boolean @default(true) @map("password_require_lowercase")
  passwordRequireNumber    Boolean @default(true) @map("password_require_number")
  passwordRequireSymbol    Boolean @default(true) @map("password_require_symbol")

  /// Role codes that must hold MFA. Seeded with CEO and FINANCE_OFFICER.
  mfaRequiredRoleCodes String[] @default([]) @map("mfa_required_role_codes")
  /// Lifetime of the pre-MFA challenge session.
  mfaChallengeTimeoutMinutes Int @default(10) @map("mfa_challenge_timeout_minutes")
  /// Lifetime of a step-up authentication grant.
  stepUpTimeoutMinutes Int @default(5) @map("step_up_timeout_minutes")

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@index([isActive, priority])
  @@map("auth_policies")
}

// ============================================================================
// B2. RBAC   (PDF 5)
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  type        RoleType @default(STANDARD)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)

  /// CEO final authority (PDF 3.1).
  isFinalApprover Boolean @default(false) @map("is_final_approver")
  /// ALWAYS false in Phase 1. No role can bypass approval; the CEO path is a
  /// recorded per-item waiver, not a standing bypass (Q3).
  canBypassApproval Boolean @default(false) @map("can_bypass_approval")

  /// Q2: every amount requires CEO approval in Phase 1. These columns exist for
  /// the future configuration path and are NOT seeded with a band.
  maxApprovalAmount Decimal? @db.Decimal(20, 6) @map("max_approval_amount")
  approvalCurrency  String?  @db.Char(3) @map("approval_currency")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  scopeGrants     RoleScopeGrant[]
  userRoles       UserRole[]
  delegations     Delegation[]
  accessReviewItems AccessReviewItem[]

  @@index([isSystem, isActive])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  module      ModuleKey
  action      PermissionAction
  /// Optional sub-resource, e.g. "supplier.bank_details".
  resource    String?
  description String?
  /// PDF 5: sensitive actions take additional authorization. Set on supplier bank
  /// details, permission changes, period reopen and high-value exports.
  requiresStepUpAuth Boolean @default(false) @map("requires_step_up_auth")

  roles       RolePermission[]
  scopeGrants RoleScopeGrant[]

  @@unique([module, action, resource])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  /// Extra constraints attached to this specific grant.
  conditions Json?

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// PDF 4: temporary access. `expiresAt` is mandatory whenever isTemporary.
  isTemporary Boolean  @default(false) @map("is_temporary")
  startsAt    DateTime @default(now()) @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  grantedById String?  @map("granted_by_id")
  grantedAt   DateTime @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  reason      String?

  @@index([userId, revokedAt])
  @@index([roleId])
  @@index([expiresAt])
  @@map("user_roles")
}

/// Dimension-scoped grants (PDF 5). dimension_value_id = NULL means "all values".
/// DENY always wins over ALLOW (resolution order in lib/rbac/scope.ts).
model RoleScopeGrant {
  id               String          @id @default(cuid())
  roleId           String          @map("role_id")
  role             Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId     String?         @map("permission_id")
  permission       Permission?     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  dimension        ScopeDimension
  dimensionValueId String?         @map("dimension_value_id")
  includeChildren  Boolean         @default(false) @map("include_children")
  effect           String          @default("ALLOW")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([roleId, dimension])
  @@index([dimension, dimensionValueId])
  @@map("role_scope_grants")
}

/// PDF 4: delegated authority. `expiresAt` is MANDATORY and validated in code -
/// an open-ended delegation is rejected, not merely discouraged.
model Delegation {
  id        String @id @default(cuid())
  grantorId String @map("grantor_id")
  grantor   User   @relation("DelegationGrantor", fields: [grantorId], references: [id], onDelete: Cascade)
  granteeId String @map("grantee_id")
  grantee   User   @relation("DelegationGrantee", fields: [granteeId], references: [id], onDelete: Cascade)

  kind  DelegationKind
  roleId String? @map("role_id")
  role   Role?   @relation(fields: [roleId], references: [id])
  /// Dimension limits, amount ceilings, entity limits.
  scope Json?
  reason String
  startsAt DateTime @map("starts_at")
  /// Mandatory. Enforced in the service layer and by the "no unbounded
  /// delegation" test.
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  revokedById String? @map("revoked_by_id")
  revocationReason String? @map("revocation_reason")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([granteeId, expiresAt])
  @@index([grantorId])
  @@index([roleId])
  @@map("delegations")
}

model AccessReview {
  id            String             @id @default(cuid())
  name          String
  periodStart   DateTime           @map("period_start")
  periodEnd     DateTime           @map("period_end")
  status        AccessReviewStatus @default(OPEN)
  scopeJson     Json?              @map("scope_json")
  initiatedById String             @map("initiated_by_id")
  completedAt   DateTime?          @map("completed_at")
  summary       String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items AccessReviewItem[]

  @@index([status])
  @@map("access_reviews")
}

model AccessReviewItem {
  id       String @id @default(cuid())
  reviewId String @map("review_id")
  review   AccessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Held by plain id, deliberately: a review must show what was granted at the
  /// time it was opened, so it reads the role as it is now but never joins to a
  /// live user_role row.
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])
  currentExpiresAt DateTime? @map("current_expires_at")
  decision         String?
  decisionReason   String? @map("decision_reason")
  decidedById      String? @map("decided_by_id")
  decidedAt        DateTime? @map("decided_at")
  actionedAt       DateTime? @map("actioned_at")

  @@unique([reviewId, userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("access_review_items")
}

// ============================================================================
// B3. ORGANISATION ROOT
//
// Only the root row lands in M1. Locations, Departments, CostCentres, Projects,
// FundingSources and Currencies arrive in M2, which is why User.primary_location_id
// and User.home_department_id are plain scalars for now.
// ============================================================================

model Organization {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  legalName String?  @map("legal_name")
  type      OrganizationType @default(SINGLE_ENTITY)
  /// PDF 2: BLECA is not yet registered.
  registrationStatus RegistrationStatus @default(NOT_REGISTERED) @map("registration_status")
  registrationNumber String?  @map("registration_number")
  /// Nullable until registered. NEVER hardcoded.
  tin               String? @map("tin")
  baseCurrency      String  @default("TZS") @db.Char(3) @map("base_currency")
  fiscalYearStartMonth Int @default(1) @map("fiscal_year_start_month")
  fiscalYearEndDay     Int @default(31) @map("fiscal_year_end_day")
  taxJurisdictions  Json?  @map("tax_jurisdictions")
  defaultLocationId String? @map("default_location_id")
  isActive          Boolean @default(true) @map("is_active")
  settings          Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrganizationMembership[]
  locations     Location[]
  departments   Department[]
  costCentres   CostCentre[]
  projects      Project[]
  fundingSources FundingSource[]
  masterDataChangeRequests MasterDataChangeRequest[]
  reasonCodes        ReasonCode[]
  reversalReasonCodes ReversalReasonCode[]
  productsServices   ProductService[]
  accounts      Account[]
  financialPeriods FinancialPeriod[]
  openingBalances OpeningBalance[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  journalEntries JournalEntry[]
  journalLines JournalLine[]
  transactions Transaction[]
  budgets Budget[]
  budgetLines BudgetLine[]

  @@index([registrationStatus])
  @@map("organizations")
}

model Location {
  id                   String       @id @default(cuid())
  organizationId       String       @map("organization_id")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  type                 LocationType
  isOwned              Boolean      @default(false) @map("is_owned")
  permissionReference  String?      @map("permission_reference")
  parentId             String?      @map("parent_id")
  parent               Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children             Location[]   @relation("LocationHierarchy")
  address              Json?
  timezone             String       @default("Africa/Dar_es_Salaam")
  isActive             Boolean      @default(true) @map("is_active")
  effectiveFrom        DateTime?    @map("effective_from")
  effectiveTo          DateTime?    @map("effective_to")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  users            User[]         @relation("UserPrimaryLocation")
  journalLines     JournalLine[]

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@index([parentId])
  @@map("locations")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  parentId       String?      @map("parent_id")
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users          User[]       @relation("UserHomeDepartment")
  costCentres    CostCentre[]
  journalLines   JournalLine[]

  @@unique([organizationId, code])
  @@index([parentId])
  @@map("departments")
}

model CostCentre {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?      @map("department_id")
  department     Department?  @relation(fields: [departmentId], references: [id])
  code           String
  name           String
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@index([departmentId])
  @@map("cost_centres")
}

model Project {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  status         ProjectStatus @default(DRAFT)
  startDate      DateTime?    @map("start_date")
  endDate        DateTime?    @map("end_date")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@index([status, isActive])
  @@map("projects")
}

model FundingSource {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           FundingSourceType
  description    String?
  isRestricted   Boolean           @default(false) @map("is_restricted")
  restrictions   Json?
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@map("funding_sources")
}

model Currency {
  id             String       @id @default(cuid())
  code           String       @unique @db.Char(3)
  name           String
  symbol         String?
  type           CurrencyType @default(FIAT)
  decimalPlaces  Int          @default(2)
  isBase         Boolean      @default(false) @map("is_base")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  exchangeRatesBase      ExchangeRate[] @relation("ExchangeRateBase")
  exchangeRatesQuote     ExchangeRate[] @relation("ExchangeRateQuote")
  productsServices       ProductService[]
  openingBalances        OpeningBalance[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  journalLines           JournalLine[]

  @@map("currencies")
}

model ExchangeRate {
  id             String               @id @default(cuid())
  baseCurrencyId String               @map("base_currency_id")
  baseCurrency   Currency             @relation("ExchangeRateBase", fields: [baseCurrencyId], references: [id])
  quoteCurrencyId String              @map("quote_currency_id")
  quoteCurrency   Currency             @relation("ExchangeRateQuote", fields: [quoteCurrencyId], references: [id])
  rateDate       DateTime             @map("rate_date")
  rate           Decimal              @db.Decimal(20, 10)
  source         String?              @default("MANUAL")
  differenceTreatment FxDifferenceTreatment @default(EXPENSE) @map("difference_treatment")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([baseCurrencyId, quoteCurrencyId, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

model MasterDataChangeRequest {
  id              String                    @id @default(cuid())
  organizationId  String                    @map("organization_id")
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType      AuditEntityType           @map("entity_type")
  entityId        String?                   @map("entity_id")
  proposedChanges Json                      @map("proposed_changes")
  reason          String
  status          MasterDataChangeStatus    @default(DRAFT) @map("status")
  requestedById   String                    @map("requested_by_id")
  requestedBy     User                      @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [id])
  approvedById    String?                   @map("approved_by_id")
  approvedBy      User?                     @relation("ChangeRequestApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?                 @map("approved_at")
  effectiveDate   DateTime?                 @map("effective_date")
  expiresAt       DateTime?                 @map("expires_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  versions        MasterDataVersion[]

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([requestedById])
  @@index([status, effectiveDate])
  @@map("master_data_change_requests")
}

model MasterDataVersion {
  id                 String               @id @default(cuid())
  changeRequestId    String               @map("change_request_id")
  changeRequest      MasterDataChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  entityType         AuditEntityType      @map("entity_type")
  entityId           String?              @map("entity_id")
  versionNumber      Int                  @map("version_number")
  snapshot           Json                 @map("snapshot")
  changedFields      Json?                @map("changed_fields")
  effectiveFrom      DateTime             @map("effective_from")
  effectiveTo        DateTime?            @map("effective_to")
  createdAt          DateTime             @default(now()) @map("created_at")

  @@unique([changeRequestId, versionNumber])
  @@index([entityType, entityId])
  @@index([effectiveFrom])
  @@map("master_data_versions")
}

/// Reason codes for transaction categorization (PDF 62). Seeded as reference data.
model ReasonCode {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  category       String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([category, isActive])
  @@map("reason_codes")
}

/// Lightweight product/service catalogue for revenue linkage (PDF 62).
model ProductService {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  type           String   // "PRODUCT" | "SERVICE"
  unit           String?  // e.g., "HOUR", "DAY", "UNIT", "MONTH"
  unitPrice      Decimal? @db.Decimal(20, 6) @map("unit_price")
  currencyCode   String?  @db.Char(3) @map("currency_code")
  currency       Currency? @relation(fields: [currencyCode], references: [code])
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([type, isActive])
  @@map("products_services")
}

/// Chart of Accounts — hierarchical, configurable per PDF §7.
model Account {
  id                     String        @id @default(cuid())
  organizationId         String        @map("organization_id")
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  description            String?
  type                   AccountType
  subCategory            AccountSubCategory?
  normalBalance          NormalBalance
  parentId               String?       @map("parent_id")
  parent                 Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children               Account[]     @relation("AccountHierarchy")
  isPostable             Boolean       @default(true) @map("is_postable")
  isReconcilable         Boolean       @default(false) @map("is_reconcilable")
  requiresDocument       Boolean       @default(false) @map("requires_document")
  status                 AccountStatus @default(ACTIVE)
  validatedByQualifiedAccountant Boolean @default(false) @map("validated_by_qualified_accountant")
  validatorNotes         String?       @map("validator_notes")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  openingBalances        OpeningBalance[]
  budgetLines            BudgetLine[]
  journalLines           JournalLine[]
  accountBalanceSnapshots AccountBalanceSnapshot[]

  @@unique([organizationId, code])
  @@index([parentId])
  @@index([type, status])
  @@map("accounts")
}

/// Financial Periods — monthly/quarterly/annual with lifecycle and reopen control.
model FinancialPeriod {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type             PeriodType
  status           PeriodStatus @default(OPEN)
  code             String       // e.g., "2025-01", "2025-Q1", "2025"
  name             String
  startDate        DateTime     @map("start_date")
  endDate          DateTime     @map("end_date")
  isAdjustment     Boolean      @default(false) @map("is_adjustment")
  reopenCount      Int          @default(0) @map("reopen_count")
  closedAt         DateTime?    @map("closed_at")
  lockedAt         DateTime?    @map("locked_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  openingBalances  OpeningBalance[]
  accountBalanceSnapshots AccountBalanceSnapshot[]
  journalEntries   JournalEntry[]

  @@unique([organizationId, code])
  @@index([status, startDate])
  @@index([type, startDate])
  @@map("financial_periods")
}

/// Opening Balances — one-sided/partial historical entries with verification status (PDF §2).
model OpeningBalance {
  id                     String               @id @default(cuid())
  organizationId         String               @map("organization_id")
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId              String               @map("account_id")
  account                Account              @relation(fields: [accountId], references: [id])
  periodId               String               @map("period_id")
  period                 FinancialPeriod      @relation(fields: [periodId], references: [id])
  amount                 Decimal              @db.Decimal(20, 6)
  currencyCode           String               @db.Char(3) @map("currency_code")
  currency               Currency             @relation(fields: [currencyCode], references: [code])
  isUnverified           Boolean              @default(true) @map("is_unverified")
  verificationStatus     VerificationStatus   @default(UNVERIFIED) @map("verification_status")
  verifiedByAccountantAt DateTime?            @map("verified_by_accountant_at")
  verifiedByAccountantId String?              @map("verified_by_accountant_id")
  source                 String               // mandatory provenance
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@unique([accountId, periodId])
  @@index([verificationStatus])
  @@map("opening_balances")
}

/// Account Balance Snapshots — rebuildable cache for dashboard speed.
model AccountBalanceSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String   @map("account_id")
  account        Account  @relation(fields: [accountId], references: [id])
  periodId       String   @map("period_id")
  period         FinancialPeriod @relation(fields: [periodId], references: [id])
  currencyCode   String   @db.Char(3) @map("currency_code")
  currency       Currency @relation(fields: [currencyCode], references: [code])
  debitTotal     Decimal  @db.Decimal(20, 6) @map("debit_total")
  creditTotal    Decimal  @db.Decimal(20, 6) @map("credit_total")
  balance        Decimal  @db.Decimal(20, 6)
  computedAt     DateTime @default(now()) @map("computed_at")

  @@unique([accountId, periodId, currencyCode])
  @@index([periodId])
  @@map("account_balance_snapshots")
}

/// JournalEntry — M4 double-entry core.
model JournalEntry {
  id                 String              @id @default(cuid())
  organizationId     String              @map("organization_id")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodId           String              @map("period_id")
  period             FinancialPeriod     @relation(fields: [periodId], references: [id])
  type               JournalEntryType    @default(STANDARD)
  status             JournalEntryStatus  @default(DRAFT)
  source             JournalSource       @default(MANUAL)
  number             String?             // allocated on post
  reference          String?
  description        String?
  transactionId      String?             @map("transaction_id")
  transaction        Transaction?        @relation(fields: [transactionId], references: [id])
  adjustingEntryId   String?             @map("adjusting_entry_id")
  adjustingEntry     JournalEntry?       @relation("JournalEntryAdjustments", fields: [adjustingEntryId], references: [id])
  adjustedEntries    JournalEntry[]      @relation("JournalEntryAdjustments")
  reversalReasonId   String?             @map("reversal_reason_id")
  reversalReason     ReversalReasonCode? @relation(fields: [reversalReasonId], references: [id])
  reversedEntryId    String?             @map("reversed_entry_id")
  reversedEntry      JournalEntry?       @relation("JournalEntryReversals", fields: [reversedEntryId], references: [id])
  reversingEntries   JournalEntry[]      @relation("JournalEntryReversals")
  submittedById      String?             @map("submitted_by_id")
  submittedBy        User?               @relation("JournalEntrySubmittedBy", fields: [submittedById], references: [id])
  submittedAt        DateTime?           @map("submitted_at")
  approvedById       String?             @map("approved_by_id")
  approvedBy         User?               @relation("JournalEntryApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?           @map("approved_at")
  postedById         String?             @map("posted_by_id")
  postedBy           User?               @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  postedAt           DateTime?           @map("posted_at")
  reversedById       String?             @map("reversed_by_id")
  reversedBy         User?               @relation("JournalEntryReversedBy", fields: [reversedById], references: [id])
  reversedAt         DateTime?           @map("reversed_at")
  voidedById         String?             @map("voided_by_id")
  voidedAt           DateTime?           @map("voided_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  lines              JournalLine[]

  @@unique([organizationId, number])
  @@index([periodId, status])
  @@index([transactionId])
  @@index([adjustingEntryId])
  @@index([reversedEntryId])
  @@index([reversalReasonId])
  @@map("journal_entries")
}

/// JournalLine — M4 double-entry core. Every line belongs to exactly one entry.
model JournalLine {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entryId        String       @map("entry_id")
  entry          JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id])
  lineNumber     Int          @map("line_number")
  description    String?
  debit          Decimal      @default(0) @db.Decimal(20, 6)
  credit         Decimal      @default(0) @db.Decimal(20, 6)
  currencyCode   String       @db.Char(3) @map("currency_code")
  currency       Currency     @relation(fields: [currencyCode], references: [code])
  baseAmount     Decimal      @db.Decimal(20, 6) @map("base_amount")
  fxRate         Decimal?     @db.Decimal(20, 10) @map("fx_rate")
  projectId      String?      @map("project_id")
  project        Project?     @relation(fields: [projectId], references: [id])
  departmentId   String?      @map("department_id")
  department     Department?  @relation(fields: [departmentId], references: [id])
  costCentreId   String?      @map("cost_centre_id")
  costCentre     CostCentre?  @relation(fields: [costCentreId], references: [id])
  locationId     String?      @map("location_id")
  location       Location?    @relation(fields: [locationId], references: [id])
  fundingSourceId String?     @map("funding_source_id")
  fundingSource  FundingSource? @relation(fields: [fundingSourceId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([entryId])
  @@index([accountId])
  @@index([projectId])
  @@index([departmentId])
  @@index([costCentreId])
  @@index([locationId])
  @@index([fundingSourceId])
  @@unique([entryId, lineNumber])
  @@map("journal_lines")
}

/// Reversal reason codes — seeded reference data for reversal/adjustment audit trail.
model ReversalReasonCode {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  category       ReversalReasonCategory
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  journalEntries JournalEntry[]

  @@unique([organizationId, code])
  @@index([category, isActive])
  @@map("reversal_reason_codes")
}

/// Minimal Transaction for M3 period-lock trigger (expanded in M5).
model Transaction {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         TransactionStatus    @default(DRAFT)
  date           DateTime             @db.Date
  description    String?
  reference      String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  journalEntries JournalEntry[]

  @@index([status, date])
  @@map("transactions")
}

/// Minimal Budget for M3 account relation (expanded in M9).
model Budget {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           BudgetLevel
  status         BudgetStatus    @default(DRAFT)
  periodType     BudgetPeriodType
  startDate      DateTime        @map("start_date")
  endDate        DateTime        @map("end_date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  lines          BudgetLine[]

  @@unique([organizationId, code])
  @@map("budgets")
}

/// Minimal BudgetLine for M3 account relation (expanded in M9).
model BudgetLine {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String       @map("budget_id")
  budget         Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id])
  amount         Decimal      @db.Decimal(20, 6)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([budgetId, accountId])
  @@index([accountId])
  @@map("budget_lines")
}

model OrganizationMembership {
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

// ============================================================================
// B4. AUDIT TRAIL   (PDF 54, PHASE_1_PLAN.md 7)
// ============================================================================

/// Append-only. There is no update path and no delete path - enforced by
/// database triggers (prisma/migrations/*_audit_guards), not by convention.
model AuditLog {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")

  /// Total ordering across the chain.
  sequence BigInt @unique @default(autoincrement())
  previousHash String? @map("previous_hash")
  /// sha256(previous_hash || sequence || actor_id || action || entity_type ||
  /// entity_id || changes || occurred_at).
  entryHash String @unique @map("entry_hash")
  /// HMAC-SHA256 over entry_hash with the period key (PHASE_1_PLAN.md 3.8.5).
  signature         String
  /// Which key signed this entry, so rotation stays auditable.
  signatureKeyVersion Int @default(1) @map("signature_key_version")

  actorId   String? @map("actor_id")
  /// Denormalised so the record survives user deletion.
  actorName String? @map("actor_name")
  /// Roles held at action time - survives later role changes.
  actorRoleCodes String[] @default([]) @map("actor_role_codes")

  action      AuditAction
  entityType  AuditEntityType @map("entity_type")
  entityId    String?         @map("entity_id")
  entityLabel String?         @map("entity_label")
  description String
  /// { field: { from, to } } for every mutated field.
  changes Json?
  metadata Json?

  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  requestId  String? @map("request_id")
  sessionId  String? @map("session_id")
  channel    AuditChannel @default(WEB)
  result     AuditResult   @default(SUCCESS)
  errorMessage String? @map("error_message")

  /// Event time. Client-supplied for offline sync, which is why divergence from
  /// recorded_at is itself a signal.
  occurredAt DateTime @map("occurred_at")
  /// Server write time.
  recordedAt DateTime @default(now()) @map("recorded_at")

  securityEvents SecurityEvent[]

  @@index([organizationId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId])
  @@index([action, occurredAt])
  @@index([result, occurredAt])
  @@index([requestId])
  @@map("audit_logs")
}

/// The single mutable row that anchors the hash chain. SELECT ... FOR UPDATE on
/// this row serialises concurrent audit appends, which is what makes the chain
/// gap-free: an aborted transaction rolls back the audit row and the head update
/// together, so a sequence number can never be consumed by a lost write.
model AuditChainHead {
  id        Int      @id @default(1)
  sequence  BigInt   @default(0)
  entryHash String   @default("") @map("entry_hash")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_chain_head")
}

/// Daily seals. Verification is incremental: start from the last checkpoint
/// rather than replaying the whole chain every night.
model AuditChainCheckpoint {
  id                    String                 @id @default(cuid())
  periodStart           DateTime               @map("period_start")
  periodEnd             DateTime               @map("period_end")
  sealedThroughSequence BigInt                 @map("sealed_through_sequence")
  sealedEntryHash       String                 @map("sealed_entry_hash")
  sealedAt              DateTime               @default(now()) @map("sealed_at")
  verifiedAt            DateTime?              @map("verified_at")
  status                ChainVerificationStatus @default(PENDING)
  entriesChecked        Int                    @default(0) @map("entries_checked")
  brokenAtSequence      BigInt?                @map("broken_at_sequence")
  detail                String?

  @@index([periodEnd])
  @@index([status])
  @@map("audit_chain_checkpoints")
}

model SecurityEvent {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")
  auditLogId     String? @map("audit_log_id")
  auditLog       AuditLog? @relation(fields: [auditLogId], references: [id], onDelete: SetNull)
  type           SecurityEventType
  severity       SecurityEventSeverity
  /// The subject is the RECORD, not a person (PDF 65). Kept deliberately: see
  /// AnomalyFlag in M16, which has no accused-user column at all for this reason.
  subjectType  AuditEntityType? @map("subject_type")
  subjectId    String?          @map("subject_id")
  subjectLabel String?          @map("subject_label")
  description  String
  detail       Json?
  ipAddress    String? @map("ip_address")
  userAgent    String? @map("user_agent")
  requestId    String? @map("request_id")
  /// Acknowledged by a named human before it has any effect on anything.
  acknowledgedAt      DateTime? @map("acknowledged_at")
  acknowledgedById    String?   @map("acknowledged_by_id")
  acknowledgementNote String?   @map("acknowledgement_note")
  resolvedAt          DateTime? @map("resolved_at")
  occurredAt          DateTime  @default(now()) @map("occurred_at")

  @@index([severity, occurredAt])
  @@index([type, occurredAt])
  @@index([acknowledgedAt])
  @@map("security_events")
}

// ============================================================================
// B5. INFRASTRUCTURE
// ============================================================================

/// All financial POST/PATCH/DELETE routes require an idempotency key so a
/// double-click, a retry or a replayed offline action cannot post twice.
model IdempotencyKey {
  id             String               @id @default(cuid())
  key            String
  scope          String
  actorId        String?              @map("actor_id")
  requestHash    String               @map("request_hash")
  status         IdempotencyKeyStatus @default(IN_PROGRESS)
  responseStatus Int?                 @map("response_status")
  responseBody   Json?                @map("response_body")
  createdAt      DateTime             @default(now()) @map("created_at")
  completedAt    DateTime?            @map("completed_at")
  expiresAt      DateTime             @map("expires_at")

  @@unique([key, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// B6. NOTIFICATIONS   (Q1: in-app + email live in Phase 1; SMS/PUSH Phase 2)
// ============================================================================

model Notification {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")
  userId         String  @map("user_id")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       NotificationCategory
  severity       NotificationSeverity @default(INFO)
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  title          String
  body           String
  actionUrl      String?   @map("action_url")
  /// Set when the recipient's preference suppresses this category.
  suppressedReason String? @map("suppressed_reason")
  dedupeKey      String?   @map("dedupe_key")
  readAt         DateTime? @map("read_at")
  sentAt         DateTime? @map("sent_at")
  deliveredAt    DateTime? @map("delivered_at")
  failedAt       DateTime? @map("failed_at")
  failureReason  String?   @map("failure_reason")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([userId, channel, dedupeKey])
  @@index([userId, status, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}